@page "{sector?}"
@model LicenciasCarpetas.Dashboard.Pages.SectorModel
@{
    var title = LicenciasCarpetas.Dashboard.Pages.SectorModel.SectorTitle(Model.SelectedSector);
    ViewData["Title"] = $"Solicitud de carpetas — {title}";
    var destino = Model.SelectedSector == FolderSector.Archivo
        ? "Archivo (carpetas anteriores a julio 2023)"
        : "Oficina 43 (carpetas desde julio 2023)";
}

@if (Model.Message is not null)
{
    <p class="message-banner" data-print-hide>@Model.Message</p>
}

<div class="card" style="padding:16px 20px; margin-bottom:16px;" data-print-hide>
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:12px; border-bottom:1px solid var(--color-border); padding-bottom:12px;">
        <a asp-page="/Index" class="btn-primary" style="display:inline-flex; align-items:center; gap:6px; padding:6px 14px; font-weight:600; text-decoration:none; border-radius:var(--radius); font-size:var(--font-sm);">
            ← Volver a Gestión de Licencias
        </a>
        <span style="font-size:var(--font-sm); color:var(--color-text-muted);">
            @Model.Cases.Count carpeta(s) en esta lista
        </span>
    </div>
    <p class="text-md" style="margin:0 0 10px;">
        Documento para solicitar carpetas físicas a <strong>@destino</strong>.
        @if (Model.ReachedLimit)
        {
            <strong>Hay más carpetas de las que caben en un documento</strong>
            <text>
                (@LicenciasCarpetas.Persistence.FolderCaseRepository.SectorListLimit por vez).
                Filtre por día o mes, o marque los casos que necesita, para pedirlas por tandas.
            </text>
        }
    </p>

    @* Período del documento: un día concreto (la agenda de ese día) o un mes completo. *@
    <form method="get" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap; margin-bottom:12px;">
        <input type="hidden" name="onlyMarked" value="@Model.OnlyMarked" />
        <input type="hidden" name="includePrinted" value="@Model.IncludePrinted" />
        <div>
            <label class="form-label" for="dia">Día de citación</label>
            <input type="date" name="dia" id="dia" value="@(Model.CitationDay?.ToString("yyyy-MM-dd"))" />
        </div>
        <div>
            <label class="form-label" for="mes">Mes</label>
            <select name="mes" id="mes">
                <option value="">—</option>
                @for (var month = 1; month <= 12; month++)
                {
                    <option value="@month" selected="@(Model.Month == month)">@SpanishDate.MonthName(month)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="anio">Año</label>
            <select name="anio" id="anio">
                <option value="">—</option>
                @for (var year = DateTime.Today.Year + 1; year >= DateTime.Today.Year - 3; year--)
                {
                    <option value="@year" selected="@(Model.Year == year)">@year</option>
                }
            </select>
        </div>
        <button type="submit" class="btn-primary" style="padding:8px 16px;">Aplicar</button>
        <a class="nav-pill" asp-page="/Sector" asp-route-sector="@Model.SelectedSector"
           asp-route-onlyMarked="@Model.OnlyMarked" asp-route-includePrinted="@Model.IncludePrinted">Todo</a>
    </form>

    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
        <button type="button" class="btn-primary" style="padding:8px 16px;" onclick="window.print()">
            Imprimir / Guardar como PDF
        </button>

        <form method="post" asp-page-handler="MarkPrinted"
              asp-route-sector="@Model.SelectedSector" asp-route-onlyMarked="@Model.OnlyMarked"
              asp-route-includePrinted="@Model.IncludePrinted"
              asp-route-dia="@(Model.CitationDay?.ToString("yyyy-MM-dd"))"
              asp-route-anio="@Model.Year" asp-route-mes="@Model.Month"
              onsubmit="return confirm('Se registrarán estas @Model.Cases.Count carpeta(s) como ya pedidas y no volverán a salir en el próximo documento. ¿Confirmar?');">
            <button type="submit" class="nav-pill">Marcar como pedidas</button>
        </form>

        <a class="nav-pill" asp-page="/Sector" asp-route-sector="@Model.SelectedSector"
           asp-route-onlyMarked="@(!Model.OnlyMarked)" asp-route-includePrinted="@Model.IncludePrinted"
           asp-route-dia="@(Model.CitationDay?.ToString("yyyy-MM-dd"))"
           asp-route-anio="@Model.Year" asp-route-mes="@Model.Month">
            @(Model.OnlyMarked ? "Ver todo el sector" : "Ver solo las marcadas")
        </a>

        <a class="nav-pill" asp-page="/Sector" asp-route-sector="@Model.SelectedSector"
           asp-route-onlyMarked="@Model.OnlyMarked" asp-route-includePrinted="@(!Model.IncludePrinted)"
           asp-route-dia="@(Model.CitationDay?.ToString("yyyy-MM-dd"))"
           asp-route-anio="@Model.Year" asp-route-mes="@Model.Month">
            @(Model.IncludePrinted ? "Ocultar las ya pedidas" : "Incluir las ya pedidas")
        </a>
    </div>
</div>

@* ── Documento imprimible ────────────────────────────────────────────────────────────────────
   Todo lo que va dentro de .documento se imprime; el resto de la pantalla se oculta. *@
<div class="card documento">
    <header class="documento-encabezado">
        <div>
            <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="documento-logo" />
            <h1>Solicitud de carpetas de conducir</h1>
            <p class="documento-organismo">
                Ilustre Municipalidad de Valparaíso<br />
                Departamento de Licencias de Conducir
            </p>
        </div>
        <dl class="documento-datos">
            <dt>Destino</dt><dd>@destino</dd>
            <dt>Período</dt><dd>@Model.PeriodLabel</dd>
            <dt>Fecha</dt><dd>@Model.IssuedOn.ToString("dd-MM-yyyy")</dd>
            <dt>Solicita</dt><dd>@Model.OperatorName</dd>
            <dt>Total</dt>
            <dd>
                @Model.Cases.Count carpeta(s)
                @if (Model.ReachedLimit)
                {
                    <text>— lista parcial, alcanzó el máximo por documento</text>
                }
            </dd>
        </dl>
    </header>

    @* Solo los tres datos que Archivo necesita para buscar la carpeta: quién, su RUT y de cuándo
       es la última carpeta. La fecha va con el mes escrito (15/marzo/2024) para que nadie tenga
       que adivinar si 03/04 es marzo o abril. *@
    <table class="cases documento-tabla">
        <thead>
            <tr>
                @* La numeración no es un dato del caso: es para ir tachando en papel y saber
                   cuántas carpetas se entregaron sin recontar la hoja. *@
                <th style="width:38px;">N°</th>
                <th>Nombre completo</th>
                <th>RUT</th>
                <th>Fecha de última carpeta</th>
                @if (Model.IncludePrinted)
                {
                    <th data-print-hide>Ya pedida</th>
                }
            </tr>
        </thead>
        <tbody>
        @{ var numero = 1; }
        @foreach (var item in Model.Cases)
        {
            <tr>
                <td class="text-cell">@(numero++)</td>
                <td class="text-cell" style="text-align:left;">@item.FullName</td>
                <td class="text-cell">@item.Rut</td>
                <td class="text-cell">@SpanishDate.FormatWithMonthName(item.LastFolderDate)</td>
                @if (Model.IncludePrinted)
                {
                    <td data-print-hide>
                        @if (item.SectorPrintedAt is { } pedida)
                        {
                            <form method="post" asp-page-handler="RequestAgain"
                                  asp-route-sector="@Model.SelectedSector" asp-route-onlyMarked="@Model.OnlyMarked">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="nav-pill" title="Pedida el @pedida.LocalDateTime.ToString("dd-MM-yyyy")">
                                    Volver a pedir
                                </button>
                            </form>
                        }
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>

    @if (Model.Cases.Count == 0)
    {
        <p class="text-md" style="padding:16px;">
            No hay carpetas pendientes para este sector. Marque casos en la pantalla Casos, o use
            "Incluir las ya pedidas" para ver las que ya se solicitaron.
        </p>
    }

    <section class="documento-firmas">
        <div>
            <span class="documento-linea"></span>
            <p>Solicita — @Model.OperatorName<br /><small>Depto. Licencias de Conducir</small></p>
        </div>
        <div>
            <span class="documento-linea"></span>
            <p>Entrega conforme<br /><small>@(Model.SelectedSector == FolderSector.Archivo ? "Archivo" : "Oficina 43")</small></p>
        </div>
    </section>
</div>
