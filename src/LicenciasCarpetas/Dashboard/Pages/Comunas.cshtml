@page
@model LicenciasCarpetas.Dashboard.Pages.ComunasModel
@{
    ViewData["Title"] = "Directorio de Comunas";
}

<div class="card" style="padding:14px 20px; margin-bottom:14px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
    <div style="display:flex; align-items:center; gap:10px;">
        <div style="width:34px; height:34px; border-radius:10px; background:var(--color-selected-bg); display:flex; align-items:center; justify-content:center; flex:none;">
            <svg viewBox="0 0 24 24" style="width:18px; height:18px; stroke:var(--color-primary); fill:none; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round;"><path d="M4 21V10l8-6 8 6v11"/><path d="M9 21v-6h6v6"/></svg>
        </div>
        <div>
            <h2 style="margin:0; font-size:var(--font-lg); font-weight:700; color:var(--color-text);">Directorio Oficial de Comunas</h2>
            <span style="font-size:var(--font-xs); color:var(--color-text-muted); font-weight:600;">Direcciones de Tránsito y departamentos de licencias de todo Chile</span>
        </div>
    </div>
    <div style="display:flex; align-items:center; gap:8px;">
        <span class="badge" style="background:var(--color-selected-bg); color:var(--color-accent); font-weight:700; font-size:var(--font-sm); padding:6px 12px; border-radius:999px;">
            @Model.Contacts.Count comunas registradas
        </span>
    </div>
</div>

@if (Model.Message is not null)
{
    <p class="message-banner" style="margin-bottom:14px;">@Model.Message</p>
}

<div class="card" style="padding:14px 18px; margin-bottom:14px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
    <form method="get" style="display:flex; gap:8px; align-items:flex-end; flex:1; min-width:280px;">
        <div style="flex:1;">
            <label class="form-label" for="search" style="font-weight:700; color:var(--color-text); font-size:var(--font-xs); margin-bottom:4px;">Buscar comuna o correo</label>
            <input type="text" name="search" id="search" value="@Model.Search" placeholder="ej: Valparaíso, Las Condes, Quilpué..." style="width:100%; border:1.5px solid var(--color-border); border-radius:var(--radius-sm); padding:8px 12px; font-weight:600; background:var(--color-bg);" />
        </div>
        <button type="submit" class="btn-primary" style="padding:8px 16px; font-weight:700;">Buscar</button>
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <a asp-page="/Comunas" class="nav-pill" style="padding:8px 14px; font-weight:600;">Limpiar</a>
        }
    </form>

    <div style="width:1px; height:36px; background:var(--color-border);"></div>

    <form method="post" asp-page-handler="Add" style="display:flex; gap:8px; align-items:flex-end; flex-wrap:wrap;">
        <div>
            <label class="form-label" style="font-weight:700; color:var(--color-text); font-size:var(--font-xs); margin-bottom:4px;">Nueva Comuna</label>
            <input type="text" name="comuna" required placeholder="ej: PAPUDO" style="border:1.5px solid var(--color-border); border-radius:var(--radius-sm); padding:8px 12px; font-weight:600; text-transform:uppercase; background:var(--color-bg);" />
        </div>
        <div>
            <label class="form-label" style="font-weight:700; color:var(--color-text); font-size:var(--font-xs); margin-bottom:4px;">Correo Municipal</label>
            <input type="text" name="correo" required placeholder="ej: licencias@munipapudo.cl" style="border:1.5px solid var(--color-border); border-radius:var(--radius-sm); padding:8px 12px; background:var(--color-bg);" />
        </div>
        <button type="submit" class="btn-primary" style="padding:8px 16px; font-weight:700; background:var(--color-uploaded) !important; border-color:var(--color-uploaded) !important;">+ Agregar</button>
    </form>
</div>

<div class="card table-card" style="overflow:hidden;">
    <form id="edit-anti-forgery-form" method="post" style="display:none;"></form>
    <table class="cases" style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="background:#fafbfd; color:var(--color-text);">
                <th style="text-align:left; padding:12px 16px; font-weight:700; text-transform:uppercase; font-size:var(--font-xs); letter-spacing:0.5px; width:35%; color:var(--color-text-muted);">Comuna</th>
                <th style="text-align:left; padding:12px 16px; font-weight:700; text-transform:uppercase; font-size:var(--font-xs); letter-spacing:0.5px; width:45%; color:var(--color-text-muted);">Correo Electrónico de Contacto</th>
                <th style="text-align:center; padding:12px 16px; font-weight:700; text-transform:uppercase; font-size:var(--font-xs); letter-spacing:0.5px; width:20%; color:var(--color-text-muted);">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Contacts.Count == 0)
        {
            <tr>
                <td colspan="3" style="text-align:center; padding:32px; color:var(--color-text-muted); font-weight:600;">
                    No se encontraron comunas que coincidan con la búsqueda "@Model.Search".
                </td>
            </tr>
        }
        else
        {
            var idx = 0;
            @foreach (var contact in Model.Contacts)
            {
                var bg = idx % 2 == 1 ? "background:#fafbfd;" : "background:#ffffff;";
                idx++;
                <tr id="row-@contact.Id" style="@bg border-bottom:1px solid var(--color-border-subtle);">
                    <td class="text-cell" style="padding:10px 16px;">
                        <span id="view-comuna-@contact.Id" style="text-transform:uppercase; font-weight:700; color:var(--color-text);">📍 @contact.Comuna</span>
                        <input type="text" id="edit-comuna-@contact.Id" value="@contact.Comuna" style="display:none; width:100%; border:1.5px solid var(--color-accent); border-radius:var(--radius-sm); padding:4px 8px; font-weight:700; text-transform:uppercase; background:#ffffff;" />
                    </td>
                    <td class="text-cell" style="padding:10px 16px;">
                        <span id="view-email-@contact.Id">
                            <a href="mailto:@contact.Email" style="color:var(--color-accent); font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
                                ✉️ @contact.Email
                            </a>
                        </span>
                        <input type="email" id="edit-email-@contact.Id" value="@contact.Email" style="display:none; width:100%; border:1.5px solid var(--color-accent); border-radius:var(--radius-sm); padding:4px 8px; font-weight:600; background:#ffffff;" />
                    </td>
                    <td style="text-align:center; padding:10px 16px; white-space:nowrap;">
                        <div id="view-actions-@contact.Id" style="display:inline-flex; gap:6px; align-items:center; justify-content:center;">
                            <button type="button" class="btn-outline" style="padding:5px 12px; border-radius:999px; font-size:var(--font-xs); font-weight:700; cursor:pointer;" onclick="startEditComuna(@contact.Id)">✏️ Editar</button>
                            <form method="post" asp-page-handler="Delete" asp-route-search="@Model.Search"
                                  onsubmit="return confirm('¿Eliminar el contacto de @contact.Comuna?');" style="display:inline;">
                                <input type="hidden" name="id" value="@contact.Id" />
                                <button type="submit" class="btn-danger" style="padding:5px 10px; border-radius:999px; font-size:var(--font-xs); font-weight:700; cursor:pointer;" title="Eliminar contacto">✕ Quitar</button>
                            </form>
                        </div>
                        <div id="edit-actions-@contact.Id" style="display:none; gap:6px; align-items:center; justify-content:center;">
                            <button type="button" class="btn-primary" style="padding:5px 12px; border-radius:999px; font-size:var(--font-xs); font-weight:700; background:var(--color-uploaded) !important; border-color:var(--color-uploaded) !important; cursor:pointer;" onclick="saveEditComuna(@contact.Id)">💾 Guardar</button>
                            <button type="button" class="nav-pill" style="padding:4px 8px; border-radius:4px; font-size:var(--font-xs); font-weight:600; cursor:pointer;" onclick="cancelEditComuna(@contact.Id)">✕ Cancelar</button>
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

<script>
    function startEditComuna(id) {
        document.getElementById('view-comuna-' + id).style.display = 'none';
        document.getElementById('edit-comuna-' + id).style.display = 'block';
        document.getElementById('view-email-' + id).style.display = 'none';
        document.getElementById('edit-email-' + id).style.display = 'block';
        document.getElementById('view-actions-' + id).style.display = 'none';
        document.getElementById('edit-actions-' + id).style.display = 'inline-flex';
        document.getElementById('edit-comuna-' + id).focus();
    }

    function cancelEditComuna(id) {
        document.getElementById('view-comuna-' + id).style.display = 'inline';
        document.getElementById('edit-comuna-' + id).style.display = 'none';
        document.getElementById('view-email-' + id).style.display = 'inline';
        document.getElementById('edit-email-' + id).style.display = 'none';
        document.getElementById('view-actions-' + id).style.display = 'inline-flex';
        document.getElementById('edit-actions-' + id).style.display = 'none';
    }

    function saveEditComuna(id) {
        var comuna = document.getElementById('edit-comuna-' + id).value.trim();
        var correo = document.getElementById('edit-email-' + id).value.trim();

        if (!comuna || !correo || !correo.includes('@@')) {
            alert('Por favor ingrese un nombre de comuna y un correo electrónico válido.');
            return;
        }

        var tokenInput = document.querySelector('#edit-anti-forgery-form input[name="__RequestVerificationToken"]');
        var token = tokenInput ? tokenInput.value : '';

        var body = '__RequestVerificationToken=' + encodeURIComponent(token) +
                   '&id=' + encodeURIComponent(id) +
                   '&comuna=' + encodeURIComponent(comuna) +
                   '&correo=' + encodeURIComponent(correo);

        fetch('?handler=Edit', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: body
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data && data.ok) {
                document.getElementById('view-comuna-' + id).textContent = '📍 ' + comuna.toUpperCase();
                var emailLink = document.querySelector('#view-email-' + id + ' a');
                if (emailLink) {
                    emailLink.href = 'mailto:' + correo;
                    emailLink.textContent = '✉️ ' + correo;
                }
                cancelEditComuna(id);
                var row = document.getElementById('row-' + id);
                if (row) {
                    row.style.background = '#dcfce7';
                    setTimeout(function() { row.style.background = ''; }, 1200);
                }
            } else {
                alert(data.message || 'Error al guardar la comuna.');
            }
        })
        .catch(function() {
            alert('Error de conexión al guardar.');
        });
    }
</script>
