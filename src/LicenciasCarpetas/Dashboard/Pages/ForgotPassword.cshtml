@page
@model LicenciasCarpetas.Dashboard.Pages.ForgotPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Restablecer contraseña — Gestión de Licencias</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="login-shell">
        <div class="login-card" style="max-width:480px;">
            <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="login-logo" />
            <h1>Restablecer contraseña</h1>
            <p class="subtitle">Municipalidad de Valparaíso — Depto. Licencias de Conducir</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="login-error" role="alert">
                    @Model.ErrorMessage
                </div>
            }

            <form method="post" style="margin-top: 18px; text-align: left;">
                <div class="form-group">
                    <label for="username" style="display:block; font-weight:600; margin-bottom:6px;">Usuario</label>
                    @if (Model.AvailableUsernames.Count > 0)
                    {
                        <select id="username" name="Username" class="form-control" style="width:100%; padding:9px 12px; font-size:14px; border-radius:6px; border:1px solid #c9d2db; background:#fff; margin-bottom:14px;" required>
                            @foreach (var u in Model.AvailableUsernames)
                            {
                                <option value="@u" selected="@(u == "raul" ? "selected" : null)">@u</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input id="username" name="Username" type="text" class="form-control" value="raul" style="width:100%; padding:9px 12px; font-size:14px; border-radius:6px; border:1px solid #c9d2db; margin-bottom:14px;" required />
                    }
                </div>

                <div class="form-group">
                    <label for="newPassword" style="display:block; font-weight:600; margin-bottom:6px;">Nueva Contraseña (mínimo 8 caracteres)</label>
                    <input id="newPassword" name="NewPassword" type="password" class="form-control" style="width:100%; padding:9px 12px; font-size:14px; border-radius:6px; border:1px solid #c9d2db; margin-bottom:14px;" placeholder="Ingrese nueva clave" required minlength="8" />
                </div>

                <div class="form-group">
                    <label for="confirmPassword" style="display:block; font-weight:600; margin-bottom:6px;">Confirmar Nueva Contraseña</label>
                    <input id="confirmPassword" name="ConfirmPassword" type="password" class="form-control" style="width:100%; padding:9px 12px; font-size:14px; border-radius:6px; border:1px solid #c9d2db; margin-bottom:20px;" placeholder="Repita la nueva clave" required minlength="8" />
                </div>

                <button type="submit" class="btn btn-primary" style="width:100%; padding:12px; font-weight:bold; font-size:15px; border-radius:6px; background:#005ea6; color:#fff; border:none; cursor:pointer;">
                    Guardar nueva contraseña y desbloquear
                </button>
            </form>

            <p class="subtitle" style="margin-top:20px;"><a asp-page="/Login">Volver al ingreso</a></p>
        </div>
    </div>
</body>
</html>
