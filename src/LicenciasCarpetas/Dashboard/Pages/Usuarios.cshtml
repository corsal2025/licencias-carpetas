@page
@using LicenciasCarpetas.Dashboard.Auth
@using LicenciasCarpetas.Domain
@model LicenciasCarpetas.Dashboard.Pages.UsuariosModel
@{
    ViewData["Title"] = "Usuarios";
}

@if (Model.Message is not null)
{
    <p class="message-banner @(Model.MessageIsError ? "message-error" : "")">@Model.Message</p>
}

<div class="card" style="padding:20px 24px; margin-bottom:16px; max-width:820px;">
    <h1 class="text-xl" style="margin:0 0 4px;">Crear usuario</h1>
    <p class="text-md" style="margin:0 0 14px;">
        Mínimo @LicenciasCarpetas.Dashboard.Auth.UserProvisioning.MinimumPasswordLength caracteres.
        El nombre de usuario no distingue mayúsculas.
    </p>
    <form method="post" asp-page-handler="Create" class="usuario-form" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;">
        <div>
            <label class="form-label">Usuario</label>
            <input type="text" name="usuario" required placeholder="ej: raul" autocomplete="off" />
        </div>
        <div>
            <label class="form-label">Contraseña</label>
            <input type="password" name="clave" required class="reveal-target" autocomplete="new-password" />
        </div>
        <div>
            <label class="form-label">Repetir contraseña</label>
            <input type="password" name="confirmacion" required class="reveal-target" autocomplete="new-password" />
        </div>
        <div>
            <label class="form-label">Rol</label>
            <select name="rol" class="rol-select">
                @foreach (var rol in Enum.GetValues<UserRole>())
                {
                    <option value="@rol" selected="@(rol == UserRole.Administrativo)">@UserRoleCatalog.Display(rol)</option>
                }
            </select>
        </div>
        <div class="modulos-administrativo">
            <label class="form-label">Módulos (solo Administrativo)</label>
            <label class="text-md" style="display:flex; gap:4px; align-items:center;">
                <input type="checkbox" name="moduloCambioDomicilio" value="true" /> Cambio de Domicilio
            </label>
            <label class="text-md" style="display:flex; gap:4px; align-items:center;">
                <input type="checkbox" name="moduloF8" value="true" /> F8 Urgentes
            </label>
        </div>
        <div class="sedes-restringidas">
            <label class="form-label">Sedes (Coordinador y Administrativo)</label>
            @foreach (var office in Enum.GetValues<Office>())
            {
                <label class="text-md" style="display:flex; gap:4px; align-items:center;">
                    <input type="checkbox" name="sedes" value="@office" /> @OfficeCatalog.Display(office)
                </label>
            }
        </div>
        <button type="submit" class="btn-primary" style="padding:8px 16px;">Crear</button>
    </form>
</div>

<div class="card" style="padding:20px 24px; margin-bottom:16px; max-width:640px;">
    <h2 class="text-xl" style="margin:0 0 4px;">Cambiar la contraseña de un usuario</h2>
    <p class="text-md" style="margin:0 0 14px;">
        Para cuando alguien olvida la suya. Deja la cuenta desbloqueada de inmediato.
    </p>
    <form method="post" asp-page-handler="SetPassword" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;">
        <div>
            <label class="form-label">Usuario</label>
            <select name="usuario" required>
                @foreach (var username in Model.Usernames)
                {
                    <option value="@username">@username</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Contraseña nueva</label>
            <input type="password" name="clave" required class="reveal-target" autocomplete="new-password" />
        </div>
        <div>
            <label class="form-label">Repetir contraseña</label>
            <input type="password" name="confirmacion" required class="reveal-target" autocomplete="new-password" />
        </div>
        <button type="submit" class="btn-primary" style="padding:8px 16px;">Cambiar</button>
    </form>
</div>

<label class="text-md" style="display:flex; gap:6px; align-items:center; margin:0 0 16px 4px;">
    <input type="checkbox" id="reveal-passwords" /> Mostrar las contraseñas
</label>

<div class="card table-card" style="max-width:960px;">
    <table class="cases">
        <thead>
            <tr><th>Usuario</th><th>Rol</th><th>Cambio de Domicilio</th><th>F8 Urgentes</th><th>Sedes</th><th>Acción</th></tr>
        </thead>
        <tbody>
        @foreach (var user in Model.Users)
        {
            var esUnoMismo = string.Equals(user.Username, Model.CurrentUsername, StringComparison.OrdinalIgnoreCase);
            var formId = $"role-form-{user.Id}";
            <tr>
                <td class="text-cell">
                    @user.Username
                    @if (esUnoMismo)
                    {
                        <span class="badge badge-confirmed">tu sesión</span>
                    }
                </td>
                <td>
                    <select name="rol" form="@formId" class="rol-select" disabled="@esUnoMismo">
                        @foreach (var rol in Enum.GetValues<UserRole>())
                        {
                            <option value="@rol" selected="@(rol == user.Role)">@UserRoleCatalog.Display(rol)</option>
                        }
                    </select>
                </td>
                <td>
                    <input type="checkbox" name="moduloCambioDomicilio" form="@formId" value="true"
                           checked="@user.CanAccessCambioDomicilio" class="modulo-checkbox"
                           disabled="@(user.Role != UserRole.Administrativo)" />
                </td>
                <td>
                    <input type="checkbox" name="moduloF8" form="@formId" value="true"
                           checked="@user.CanAccessF8Urgentes" class="modulo-checkbox"
                           disabled="@(user.Role != UserRole.Administrativo)" />
                </td>
                <td>
                    @{ var sedesUsuario = Model.OfficesByUser.GetValueOrDefault(user.Id) ?? []; }
                    @foreach (var office in Enum.GetValues<Office>())
                    {
                        <label class="text-md" style="display:flex; gap:4px; align-items:center; white-space:nowrap;">
                            <input type="checkbox" name="sedes" form="@formId" value="@office" class="sede-checkbox"
                                   checked="@sedesUsuario.Contains(office)"
                                   disabled="@(esUnoMismo || OfficeScopeClaims.IsUnrestrictedRole(user.Role))" />
                            @OfficeCatalog.Display(office)
                        </label>
                    }
                    @if (OfficeScopeClaims.IsUnrestrictedRole(user.Role))
                    {
                        <small class="sede-todas" style="color:var(--color-text-muted);">Ve todas por su rol</small>
                    }
                </td>
                <td>
                    @if (!esUnoMismo)
                    {
                        <button type="submit" form="@formId" class="btn-primary text-base" style="padding:4px 10px;">Guardar</button>
                    }
                    <form id="@formId" method="post" asp-page-handler="UpdateRole" style="display:none;">
                        <input type="hidden" name="usuario" value="@user.Username" />
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@* El formulario de eliminar va aparte del de rol — dos <form> no pueden anidarse, y cada fila
   ahora necesita ambos. *@
<div class="card table-card" style="max-width:960px; margin-top:16px;">
    <table class="cases">
        <thead>
            <tr><th>Usuario</th><th>Eliminar</th></tr>
        </thead>
        <tbody>
        @foreach (var username in Model.Usernames)
        {
            <tr>
                <td class="text-cell">@username</td>
                <td>
                    @if (!string.Equals(username, Model.CurrentUsername, StringComparison.OrdinalIgnoreCase))
                    {
                        <form method="post" asp-page-handler="Delete"
                              onsubmit="return confirm('¿Eliminar el usuario @username?');">
                            <input type="hidden" name="usuario" value="@username" />
                            <button type="submit" class="btn-danger" title="Eliminar usuario">✕</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@* Solo Casos (Gestión de Licencias) — F8 y Cambio de Domicilio tienen su propia base y no se tocan
   acá. Se guarda un respaldo automático antes de borrar (mismo mecanismo que el de arranque); si el
   respaldo falla, no se borra nada. *@
<div class="card" style="padding:20px 24px; margin-bottom:16px; max-width:820px; border-color:var(--color-review); border-width:2px;">
    <h1 class="text-xl" style="margin:0 0 4px; color:var(--color-review);">Zona de peligro</h1>
    <p class="text-md" style="margin:0 0 14px;">
        Borra permanentemente todos los casos de Gestión de Licencias, para reiniciar el proceso
        desde cero. No toca F8, Cambio de Domicilio ni las cuentas de usuario. Antes de borrar se
        guarda un respaldo de la base completa.
    </p>
    <form method="post" asp-page-handler="ClearCasesData" class="clear-cases-form"
          style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;"
          onsubmit="return confirm('Esto borra TODOS los casos de Gestión de Licencias de forma permanente. ¿Confirmar?');">
        <div>
            <label class="form-label" for="confirmWord">
                Escriba <strong>@LicenciasCarpetas.Dashboard.Pages.UsuariosModel.ClearCasesConfirmationWord</strong> para confirmar
            </label>
            <input type="text" name="confirmWord" id="confirmWord" required autocomplete="off"
                   placeholder="@LicenciasCarpetas.Dashboard.Pages.UsuariosModel.ClearCasesConfirmationWord" />
        </div>
        <button type="submit" class="btn-outline-danger">Borrar todos los casos</button>
    </form>
</div>

<div class="card table-card" style="max-width:960px; margin-top:16px;">
    <h2 class="text-xl" style="margin:12px 16px 4px;">Historial de permisos</h2>
    <p class="text-md" style="margin:0 16px 8px;">Cada cambio de rol, módulos o sedes. Se aplica en la siguiente acción del usuario, sin que tenga que volver a entrar.</p>
    <table class="cases">
        <thead><tr><th>Fecha</th><th>Quién</th><th>A quién</th><th>Qué</th><th>Antes</th><th>Después</th></tr></thead>
        <tbody>
        @foreach (var entry in Model.PermissionLog)
        {
            <tr>
                <td>@entry.ChangedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                <td>@entry.ChangedBy</td>
                <td>@entry.TargetUsername</td>
                <td>@entry.Field</td>
                <td>@(entry.Before ?? "—")</td>
                <td>@(entry.After ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    document.getElementById('reveal-passwords').addEventListener('change', function () {
        var type = this.checked ? 'text' : 'password';
        document.querySelectorAll('.reveal-target').forEach(function (input) { input.type = type; });
    });

    // Los módulos solo aplican a Administrativo — el resto de los roles ya tiene acceso
    // incondicional, así que marcarlos ahí no cambiaría nada y solo confundiría.
    var crearRol = document.querySelector('.usuario-form .rol-select');
    var crearModulos = document.querySelector('.modulos-administrativo');
    var crearSedes = document.querySelector('.sedes-restringidas');
    function actualizarModulosCreacion() {
        var esAdministrativo = crearRol.value === 'Administrativo';
        crearModulos.style.display = esAdministrativo ? '' : 'none';
        // Administrador y Jefatura ven todas las sedes por su rol.
        crearSedes.style.display = (crearRol.value === 'Administrativo' || crearRol.value === 'Coordinador') ? '' : 'none';
    }
    if (crearRol) {
        crearRol.addEventListener('change', actualizarModulosCreacion);
        actualizarModulosCreacion();
    }

    document.querySelectorAll('table.cases tbody tr').forEach(function (row) {
        var rolSelect = row.querySelector('select.rol-select');
        var checkboxes = row.querySelectorAll('.modulo-checkbox');
        var sedes = row.querySelectorAll('.sede-checkbox');
        if (!rolSelect || checkboxes.length === 0) return;
        rolSelect.addEventListener('change', function () {
            var habilitados = rolSelect.value === 'Administrativo';
            checkboxes.forEach(function (checkbox) { checkbox.disabled = !habilitados; });
            var restringido = rolSelect.value === 'Administrativo' || rolSelect.value === 'Coordinador';
            sedes.forEach(function (checkbox) { checkbox.disabled = !restringido; });
            var nota = row.querySelector('.sede-todas');
            if (nota) nota.style.display = restringido ? 'none' : '';
        });
    });
</script>
}
