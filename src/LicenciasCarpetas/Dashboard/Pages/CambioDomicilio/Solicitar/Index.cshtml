@page
@model LicenciasCarpetas.Dashboard.Pages.CambioDomicilio.Solicitar.IndexModel
@using LicenciasCarpetas.CambioDomicilio.Domain
@using LicenciasCarpetas.Domain
@{
    ViewData["Title"] = "Solicitar Cambios de Domicilio";
    ViewData["BodyClass"] = "viewport-locked";
    var total = Model.Requests.Count;
    var borradores = Model.Requests.Count(r => r.Status == OutboundRequestStatus.Borrador);
    var enviadas = Model.Requests.Count(r => r.Status == OutboundRequestStatus.Enviada);
}

<div class="card cd-filter-bar" style="padding:10px 16px; margin-bottom:12px; display:flex; gap:12px; align-items:center; justify-content:space-between; flex-wrap:wrap;">
    <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
        <span style="font-weight:700; font-size:var(--font-lg); color:var(--color-primary); display:flex; align-items:center; gap:6px;">
            📤 Solicitudes de Cambio de Domicilio a otras Comunas
        </span>
        <span class="badge" style="background:var(--color-sidebar-active-bg); color:var(--color-primary); font-weight:600; padding:4px 8px; border-radius:6px; font-size:var(--font-sm);">
            @total total (@borradores pendientes / @enviadas enviadas)
        </span>
    </div>
</div>

@if (Model.Message is not null)
{
    <p class="message-banner">@Model.Message</p>
}

<div class="card table-card">
    <table class="cases cases-index cases-f8">
        <thead>
            <tr>
                <th style="width:40px; text-align:center;">#</th>
                <th class="name-cell">Nombre Completo</th>
                <th class="rut-cell">RUT</th>
                <th>Comuna Destino</th>
                <th>Fecha Ingreso</th>
                <th>Estado Carpeta</th>
                <th style="text-align:center; min-width:110px;">Acción</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Requests.Count == 0)
        {
            <tr>
                <td colspan="7" style="text-align:center; padding:32px; color:var(--color-text-muted);">
                    No hay solicitudes registradas. Al marcar un caso como <strong>"CAMBIO DE DOMICILIO SOLICITADO"</strong> en la Agenda o sincronizar, aparecerán aquí automáticamente.
                </td>
            </tr>
        }
        @{ var index = 1; }
        @foreach (var item in Model.Requests)
        {
            var rowClass = FolderStateCatalog.CssClass(item.WorkflowState);
            <tr class="@rowClass">
                <td style="text-align:center; color:var(--color-text-muted); font-size:var(--font-xs);">@(index++)</td>
                <td class="name-cell" style="font-weight:600;">@item.FullName</td>
                <td class="rut-cell">
                    <input type="text" class="input-inline rut-input" value="@item.Rut" readonly size="14" style="background:transparent; border:none; font-weight:600;" />
                </td>
                <td style="font-weight:700; text-transform:uppercase; color:var(--color-primary);">@item.DestinationComuna</td>
                <td>@item.CreatedAt.LocalDateTime.ToString("dd-MM-yyyy")</td>
                <td>
                    <form method="post" asp-page-handler="GuardarEstado" asp-route-id="@item.Id" style="margin:0;">
                        <select name="workflowState" class="input-inline" style="font-size:var(--font-sm); padding:3px 6px;" onchange="this.form.submit()">
                            <option value="">—</option>
                            @foreach (var state in WorkflowStateCatalog.Options)
                            {
                                <option value="@state" selected="@(item.WorkflowState == state)">@WorkflowStateCatalog.Display(state)</option>
                            }
                        </select>
                    </form>
                </td>
                <td style="text-align:center; white-space:nowrap;">
                  <div style="display:inline-flex; gap:6px; align-items:center; justify-content:center;">
                    @if (item.Status == OutboundRequestStatus.Borrador)
                    {
                        <form method="post" asp-page-handler="Solicitar" asp-route-id="@item.Id" style="display:inline;"
                              onsubmit="return confirm('Esto mandará el correo formal de solicitud a la Municipalidad de ' + '@(item.DestinationComuna?.Replace("'", "\\'"))' + '. ¿Confirmar envío?');">
                            <button type="submit" class="btn-primary" style="padding:3px 10px; font-size:var(--font-xs);">
                                ✉️ Solicitar
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="badge badge-confirmed" style="font-size:var(--font-xs);" title="Enviada el @(item.SentAt?.LocalDateTime.ToString("dd-MM-yyyy HH:mm") ?? "—")">
                            ✓ Enviada
                        </span>
                    }
                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" style="display:inline;"
                          onsubmit="return confirm('¿Eliminar esta solicitud de cambio de domicilio?');">
                        <button type="submit" class="btn-danger" style="padding:3px 8px; border-radius:4px; font-size:var(--font-xs); font-weight:700; cursor:pointer;" title="Eliminar solicitud">🗑️</button>
                    </form>
                  </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
