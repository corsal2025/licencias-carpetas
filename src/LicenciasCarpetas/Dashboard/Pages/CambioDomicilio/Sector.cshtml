@page "{sector?}"
@model LicenciasCarpetas.Dashboard.Pages.CambioDomicilio.SectorModel
@{
    var sectorTitle = Model.SelectedSector == LicenciasCarpetas.CambioDomicilio.Domain.FolderSector.Archivo ? "Archivo" : "Oficina 43";
    ViewData["Title"] = $"Solicitud de carpetas — {sectorTitle}";
    var destino = Model.SelectedSector == LicenciasCarpetas.CambioDomicilio.Domain.FolderSector.Archivo
        ? "Archivo (carpetas anteriores a julio 2023)"
        : "Oficina 43 (carpetas desde julio 2023)";
}

<form id="mark-printed-form" method="post" asp-page-handler="MarkPrinted" asp-route-sector="@Model.SelectedSector" style="display:none;"></form>

<div class="card" style="padding:16px 20px; margin-bottom:16px;" data-print-hide>
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:12px; border-bottom:1px solid var(--color-border); padding-bottom:12px;">
        <a asp-page="/CambioDomicilio/Index" class="btn-primary" style="display:inline-flex; align-items:center; gap:6px; padding:6px 14px; font-weight:600; text-decoration:none; border-radius:var(--radius); font-size:var(--font-sm);">
            ← Volver a Cambio de Domicilio
        </a>
        <span style="font-size:var(--font-sm); color:var(--color-text-muted);">
            @Model.Cases.Count carpeta(s) en esta lista
        </span>
    </div>
    <p class="text-md" style="margin:0 0 10px;">
        Documento para solicitar carpetas físicas a <strong>@destino</strong>.
    </p>

    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
        <button type="button" class="btn-primary" style="padding:8px 16px;" onclick="markPrintedAndPrint()">
            Imprimir / Guardar como PDF
        </button>

        @if (Model.Cases.Count > 0)
        {
            <form method="post" asp-page-handler="ClearAll" asp-route-sector="@Model.SelectedSector"
                  onsubmit="return confirm('Esto vacía el listado de este sector — quedará en blanco para volver a llenarse con nuevos casos. NO elimina los datos de los contribuyentes, solo los saca de esta lista. ¿Confirmar?');">
                <button type="submit" class="nav-pill">Vaciar listado</button>
            </form>
        }
    </div>
</div>

<div class="card documento">
    <header class="documento-encabezado">
        <div>
            <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="documento-logo" />
            <h1>Solicitud de carpetas de conducir</h1>
            <p class="documento-organismo">
                Ilustre Municipalidad de Valparaíso<br />
                Departamento de Licencias de Conducir
            </p>
        </div>
        <dl class="documento-datos">
            <dt>Destino</dt><dd>@destino</dd>
            <dt>Período</dt><dd>Todas las carpetas pendientes</dd>
            <dt>Fecha</dt><dd>@DateTime.Today.ToString("dd-MM-yyyy")</dd>
            <dt>Solicita</dt><dd>@Model.OperatorName</dd>
            <dt>Total</dt><dd>@Model.Cases.Count carpeta(s)</dd>
        </dl>
    </header>

    <table class="cases documento-tabla">
        <thead>
            <tr>
                <th style="width:38px;">N°</th>
                <th>Nombre completo</th>
                <th>RUT</th>
                <th>Comuna</th>
                <th>Fecha de última carpeta</th>
            </tr>
        </thead>
        <tbody>
        @{ var numero = 1; }
        @foreach (var item in Model.Cases)
        {
            <tr>
                <td class="text-cell">@(numero++)</td>
                <td class="text-cell" style="text-align:left;">@item.FullName</td>
                <td class="text-cell">@item.Rut</td>
                <td class="text-cell">@item.Comuna</td>
                <td class="text-cell">@(item.FechaUltimaCarpeta is { } f ? LicenciasCarpetas.CambioDomicilio.Domain.SpanishDate.Format(f) : "")</td>
            </tr>
        }
        </tbody>
    </table>

    @if (Model.Cases.Count == 0)
    {
        <p class="text-md" style="padding:16px; text-align:center; color:var(--color-text-muted);">
            No hay carpetas pendientes para este sector. Marque casos en Cambio de Domicilio para incluirlos en la lista.
        </p>
    }

    <section class="documento-firmas">
        <div>
            <span class="documento-linea"></span>
            <p>Solicita — @Model.OperatorName<br /><small>Depto. Licencias de Conducir</small></p>
        </div>
        <div>
            <span class="documento-linea"></span>
            <p>Entrega conforme<br /><small>@(Model.SelectedSector == LicenciasCarpetas.CambioDomicilio.Domain.FolderSector.Archivo ? "Archivo" : "Oficina 43")</small></p>
        </div>
    </section>
</div>

<script>
    function markPrintedAndPrint() {
        var form = document.getElementById('mark-printed-form');
        var token = form ? form.querySelector('input[name="__RequestVerificationToken"]')?.value : null;
        if (form && token) {
            fetch(form.action, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '__RequestVerificationToken=' + encodeURIComponent(token)
            }).finally(function () {
                window.print();
            });
        } else {
            window.print();
        }
    }
</script>
