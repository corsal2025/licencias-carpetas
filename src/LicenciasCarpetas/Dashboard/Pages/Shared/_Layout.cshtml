<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Gestión de Licencias</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" media="print" onload="this.media='all'" />
    <script type="speculationrules">
    {
      "prerender": [
        {
          "source": "list",
          "urls": ["/Inicio", "/Index", "/CambioDomicilio/Index", "/F8/Index", "/Estadisticas"]
        }
      ]
    }
    </script>
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    @* Cada módulo trae su propio hoja de estilos, cargada solo en sus páginas — comparten
       las mismas variables de color (mismo autor, misma paleta) así que no chocan si una
       regla genérica (.card, body) queda definida en las dos. *@
    @await RenderSectionAsync("Styles", required: false)
</head>
@* "viewport-locked" solo lo pide la pantalla de Casos, que fija su tabla al alto de la ventana.
   El resto se desplaza como una página normal. *@
<body class="cases-page @ViewData["BodyClass"]">
    @{
        // El título del bloque de marca y qué opción del desplegable "Módulos" se marca activa
        // salen los dos de BrandNavigation.Resolve — antes cada uno recalculaba la ruta actual por
        // su cuenta, con riesgo real de desincronizarse entre sí; ver BrandNavigation.cs y sus tests.
        var nav = LicenciasCarpetas.Dashboard.Pages.Shared.BrandNavigation.Resolve(Context.Request.Path);
        var brandTitle = nav.Title;
        var enCambioDomicilio = nav.EnCambioDomicilio;
        var enCambioDomicilioSolicitar = nav.EnCambioDomicilioSolicitar;
        var enF8 = nav.EnF8;
        var enGestionLicencias = nav.EnGestionLicencias;
        var estadisticasPage = nav.EstadisticasPage;
    }
    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="sidebar-brand">
                <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="brand-logo" />
                <span>
                    @brandTitle
                    <small>Municipalidad de Valparaíso</small>
                    <small>Depto. Licencias de Conducir</small>
                </span>
            </div>
            @{
                // Mismos roles que los [Authorize(Roles=...)] de cada PageModel — si una pantalla no
                // deja entrar a un rol por URL directa, tampoco le muestra el link.
                var puedeVerReportesYReferencia = User.IsInRole("Administrador") || User.IsInRole("Jefatura") || User.IsInRole("Coordinador");
                var puedeImportar = User.IsInRole("Administrador") || User.IsInRole("Jefatura");
                var puedeCambioDomicilio = User.IsInRole("Administrador") || User.IsInRole("Jefatura") || User.HasClaim("mod:cambio-domicilio", "true");
                var puedeF8 = User.IsInRole("Administrador") || User.IsInRole("Jefatura") || User.HasClaim("mod:f8-urgentes", "true");
                var puedeVerEstadisticasDelModuloActivo = enCambioDomicilio || enF8 || puedeVerReportesYReferencia;
            }
            <nav class="sidebar-nav">
                <button type="button" class="sidebar-search-btn" onclick="openGlobalSearch()" style="margin-bottom: 8px;">
                    <span class="search-label"><svg class="sidebar-icon" viewBox="0 0 24 24" style="width:14px;height:14px;"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg> Buscar...</span>
                    <kbd>Ctrl+K</kbd>
                </button>

                <div class="sidebar-section-title">GENERAL</div>
                <a asp-page="/Inicio" class="sidebar-link @(Context.Request.Path == "/Inicio" ? "active" : "")">
                    <span class="sidebar-emoji">📊</span> <span>Panel de Control</span>
                </a>
                <a asp-page="/Index" class="sidebar-link @((Context.Request.Path == "/" || Context.Request.Path.StartsWithSegments("/Index")) ? "active" : "")">
                    <span class="sidebar-emoji">🪪</span> <span>Gestión de Licencias</span>
                </a>

                <div class="sidebar-section-title">MÓDULOS ESPECIALES</div>
                @if (puedeCambioDomicilio)
                {
                    <a asp-page="/CambioDomicilio/Index" class="sidebar-link @(enCambioDomicilio && !enCambioDomicilioSolicitar && Context.Request.Path.Value?.Contains("Estadisticas", StringComparison.OrdinalIgnoreCase) != true ? "active" : "")">
                        <span class="sidebar-emoji">📥</span> <span>Enviar Cambios de Domicilio a Otras Comunas</span>
                    </a>
                    <a asp-page="/CambioDomicilio/Solicitar/Index" class="sidebar-link @(enCambioDomicilioSolicitar && Context.Request.Path.Value?.Contains("Estadisticas", StringComparison.OrdinalIgnoreCase) != true ? "active" : "")">
                        <span class="sidebar-emoji">📤</span> <span>Solicitar Cambio de Domicilio a Otras Comunas</span>
                    </a>
                }
                @if (puedeF8)
                {
                    <a asp-page="/F8/Index" class="sidebar-link @(enF8 && Context.Request.Path.Value?.Contains("Estadisticas", StringComparison.OrdinalIgnoreCase) != true ? "active" : "")">
                        <span class="sidebar-emoji">⚡</span> <span>F8 Urgentes</span>
                    </a>
                }
                @if (puedeCambioDomicilio || puedeF8)
                {
                    <a asp-page="/Certificados/Index" class="sidebar-link @(Context.Request.Path.Value?.StartsWith("/Certificados", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")">
                        <span class="sidebar-emoji">📜</span> <span>Carpetas para Certificados</span>
                    </a>
                }
                @if (puedeVerEstadisticasDelModuloActivo)
                {
                    <a asp-page="@estadisticasPage" class="sidebar-link @(Context.Request.Path.Value?.Contains("Estadisticas", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")">
                        <span class="sidebar-emoji">📈</span> <span>Estadísticas</span>
                    </a>
                }

                <div class="sidebar-section-title">ADMINISTRACIÓN</div>
                @if (puedeImportar)
                {
                    <a asp-page="/Importar" class="sidebar-link @(Context.Request.Path == "/Importar" ? "active" : "")">
                        <span class="sidebar-emoji">📥</span> <span>Importar Excel</span>
                    </a>
                }
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-page="/Usuarios" class="sidebar-link @(Context.Request.Path == "/Usuarios" ? "active" : "")">
                        <span class="sidebar-emoji">👥</span> <span>Usuarios y Roles</span>
                    </a>
                }
                @if (puedeVerReportesYReferencia)
                {
                    <a asp-page="/Comunas" class="sidebar-link @(Context.Request.Path == "/Comunas" ? "active" : "")">
                        <span class="sidebar-emoji">🏛️</span> <span>Comunas</span>
                    </a>
                }
                @if (enGestionLicencias && puedeVerReportesYReferencia)
                {
                    <a asp-page="/Papelera" class="sidebar-link @(Context.Request.Path == "/Papelera" ? "active" : "")">
                        <span class="sidebar-emoji">🗑️</span> <span>Papelera</span>
                    </a>
                }
            </nav>
            <div class="sidebar-footer">
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-page="/Usuarios" class="sidebar-link @(Context.Request.Path == "/Usuarios" ? "active" : "")"><svg class="sidebar-icon" viewBox="0 0 24 24"><circle cx="9" cy="7" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 11c1.9.5 3.3 2.2 3.3 4.3"/><circle cx="17" cy="6" r="2.4"/></svg> Usuarios</a>
                }
                @if (enGestionLicencias && puedeVerReportesYReferencia)
                {
                    <a asp-page="/Papelera" class="sidebar-link @(Context.Request.Path == "/Papelera" ? "active" : "")"><svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M6 6v13a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V6"/><path d="M3 6h18"/><path d="M8 6V4.5A1.5 1.5 0 0 1 9.5 3h5A1.5 1.5 0 0 1 16 4.5V6"/></svg> Papelera</a>
                }
                <a asp-page="/ChangePassword" class="sidebar-link @(Context.Request.Path == "/ChangePassword" ? "active" : "")"><svg class="sidebar-icon" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg> Cambiar contraseña</a>
                <form asp-page="/Logout" method="post"><button type="submit" class="sidebar-link-logout"><svg class="sidebar-icon" viewBox="0 0 24 24" style="stroke:#fca5a5;"><path d="M9 21H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg> Salir</button></form>
            </div>
        </aside>
        <div class="app-content">
            <main>
                @RenderBody()
            </main>
            <footer class="app-footer">Desarrollado por Raúl Salazar</footer>
        </div>
    </div>

    <script src="~/js/scroll-preserve.js" asp-append-version="true"></script>

    <!-- Global Search Modal (Ctrl+K) -->
    <div id="global-search-backdrop" class="global-search-backdrop" onclick="if (event.target === this) closeGlobalSearch();">
        <div class="global-search-modal">
            <div class="global-search-header">
                <span style="font-size:18px;">🔍</span>
                <input type="text" id="global-search-input" class="global-search-input" placeholder="Buscar por RUT o nombre en todos los módulos..." autocomplete="off" />
                <button type="button" onclick="closeGlobalSearch()" style="background:none; border:none; font-size:18px; cursor:pointer; color:var(--color-text-muted);">✕</button>
            </div>
            <div id="global-search-results" class="global-search-results">
                <p style="padding:16px; color:var(--color-text-muted); margin:0; text-align:center; font-size:var(--font-sm);">Escribe un RUT (ej: 13.025.150-1) o nombre para buscar en Casos, F8 y Cambio de Domicilio.</p>
            </div>
            <div class="global-search-footer">
                <span>Presiona <kbd style="background:#e2e8f0; padding:1px 4px; border-radius:3px;">ESC</kbd> para cerrar</span>
                <span>Navegación unificada</span>
            </div>
        </div>
    </div>

    <script>
        function openGlobalSearch() {
            var backdrop = document.getElementById('global-search-backdrop');
            var input = document.getElementById('global-search-input');
            if (!backdrop || !input) return;
            backdrop.classList.add('open');
            input.value = '';
            input.focus();
            renderGlobalSearchResults([]);
        }

        function closeGlobalSearch() {
            var backdrop = document.getElementById('global-search-backdrop');
            if (backdrop) backdrop.classList.remove('open');
        }

        document.addEventListener('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                var backdrop = document.getElementById('global-search-backdrop');
                if (backdrop && backdrop.classList.contains('open')) {
                    closeGlobalSearch();
                } else {
                    openGlobalSearch();
                }
            } else if (e.key === 'Escape') {
                closeGlobalSearch();
            }
        });

        var searchDebounceTimer = null;
        var searchInput = document.getElementById('global-search-input');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var query = this.value.trim();
                clearTimeout(searchDebounceTimer);
                if (query.length < 2) {
                    renderGlobalSearchResults([]);
                    return;
                }
                searchDebounceTimer = setTimeout(function () {
                    fetch('/api/global-search?q=' + encodeURIComponent(query))
                        .then(function (res) { return res.json(); })
                        .then(function (data) { renderGlobalSearchResults(data, query); })
                        .catch(function () { renderGlobalSearchResults([], query, true); });
                }, 200);
            });
        }

        function renderGlobalSearchResults(items, query, isError) {
            var container = document.getElementById('global-search-results');
            if (!container) return;

            if (isError) {
                container.innerHTML = '<p style="padding:16px; color:#b91c1c; margin:0; text-align:center; font-size:var(--font-sm);">Error al buscar resultados.</p>';
                return;
            }

            if (!query || query.length < 2) {
                container.innerHTML = '<p style="padding:16px; color:var(--color-text-muted); margin:0; text-align:center; font-size:var(--font-sm);">Escribe un RUT o nombre para buscar en todos los módulos.</p>';
                return;
            }

            if (!items || items.length === 0) {
                container.innerHTML = '<p style="padding:16px; color:var(--color-text-muted); margin:0; text-align:center; font-size:var(--font-sm);">No se encontraron coincidencias para "<strong>' + escapeHtml(query) + '</strong>".</p>';
                return;
            }

            var html = '';
            var currentModule = '';
            items.forEach(function (item) {
                if (item.module !== currentModule) {
                    currentModule = item.module;
                    html += '<div class="global-search-group">' + escapeHtml(currentModule) + '</div>';
                }
                html += '<a href="' + item.url + '" class="global-search-item">';
                html += '  <div>';
                html += '    <div style="font-weight:600;">' + escapeHtml(item.title) + (item.rut ? ' <span style="font-weight:normal; color:var(--color-text-muted);">(' + escapeHtml(item.rut) + ')</span>' : '') + '</div>';
                if (item.detail) {
                    html += '    <div style="font-size:var(--font-xs); color:var(--color-text-muted);">' + escapeHtml(item.detail) + '</div>';
                }
                html += '  </div>';
                if (item.status) {
                    html += '  <span class="badge-sla badge-sla-normal" style="font-size:var(--font-xs);">' + escapeHtml(item.status) + '</span>';
                }
                html += '</a>';
            });
            container.innerHTML = html;
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // Formato al copiar RUT: sin puntos, con guión, y con cero a la izquierda si es menor a 10 millones
        function formatRutForClipboard(text) {
            if (!text) return '';
            var clean = text.replace(/[\.\s]/g, '').trim();
            if (!clean) return text;

            var match = clean.match(/^(\d{1,8})-?([\dkK])$/i);
            if (match) {
                var cuerpo = match[1];
                var dv = match[2].toUpperCase();
                cuerpo = cuerpo.padStart(8, '0');
                return cuerpo + '-' + dv;
            }
            return clean;
        }

        document.addEventListener('copy', function (event) {
            var active = document.activeElement;
            var isRutTarget = active && (
                active.classList.contains('rut-input') ||
                active.name === 'rut' ||
                active.id === 'drawer-rut' ||
                (active.closest && (active.closest('.rut-cell') || active.closest('.col-sticky-rut') || active.closest('.rut-con-obs')))
            );

            var textToFormat = null;
            if (isRutTarget && active.value) {
                textToFormat = active.value.substring(active.selectionStart, active.selectionEnd) || active.value;
            } else {
                var selection = window.getSelection ? window.getSelection().toString().trim() : '';
                var cleanSel = selection.replace(/[\.\s]/g, '');
                if (/^\d{6,8}-?[\dkK]$/i.test(cleanSel)) {
                    textToFormat = selection;
                }
            }

            if (textToFormat) {
                var formatted = formatRutForClipboard(textToFormat);
                if (formatted) {
                    event.clipboardData.setData('text/plain', formatted);
                    event.preventDefault();
                }
            }
        });
    </script>

    <script>
        // Navegacion ultra-rapida y prefetch anticipado para eliminar lag entre secciones
        (function() {
            function prefetchUrl(url) {
                if (!url || url.indexOf('#') !== -1 || url.indexOf('Export') !== -1) return;
                var link = document.createElement('link');
                link.rel = 'prefetch';
                link.href = url;
                document.head.appendChild(link);
            }

            document.addEventListener('mouseover', function (e) {
                var a = e.target.closest('a[href^="/"]');
                if (!a || a.dataset.prefetched || a.getAttribute('target')) return;
                a.dataset.prefetched = 'true';
                prefetchUrl(a.href);
            }, { passive: true });

            document.addEventListener('touchstart', function (e) {
                var a = e.target.closest('a[href^="/"]');
                if (!a || a.dataset.prefetched || a.getAttribute('target')) return;
                a.dataset.prefetched = 'true';
                prefetchUrl(a.href);
            }, { passive: true });

            document.addEventListener('click', function (e) {
                var link = e.target.closest('.sidebar-link, .cd-filter-bar a');
                if (link && link.getAttribute('href') && !link.getAttribute('href').startsWith('#') && !link.getAttribute('target')) {
                    var group = link.classList.contains('sidebar-link') ? '.sidebar-link.active' : '.cd-filter-bar a.active';
                    document.querySelectorAll(group).forEach(function (el) {
                        el.classList.remove('active');
                    });
                    link.classList.add('active');
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
