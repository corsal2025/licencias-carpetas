@page
@model LicenciasCarpetas.Dashboard.Pages.F8.ImpresionMensualModel
@{
    ViewData["Title"] = "Impresión mensual — F8";
}

<div class="card" style="padding:16px 20px; margin-bottom:16px;" data-print-hide>
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:12px; border-bottom:1px solid var(--color-border); padding-bottom:12px;">
        <a asp-page="/F8/Index" class="btn-primary" style="display:inline-flex; align-items:center; gap:6px; padding:6px 14px; font-weight:600; text-decoration:none; border-radius:var(--radius); font-size:var(--font-sm);">
            ← Volver a Solicitudes F8
        </a>
        <span style="font-size:var(--font-sm); color:var(--color-text-muted);">
            @Model.Cases.Count carpeta(s) en esta lista
        </span>
    </div>
    <p class="text-md" style="margin:0 0 10px;">
        Documento de impresión mensual de casos completados (SUBIDA A CONASET) para el mes seleccionado.
    </p>

    <form method="get" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap; margin-bottom:12px;">
        <div>
            <label class="form-label" for="month">Mes de trabajo</label>
            <input type="month" id="month" name="month" value="@Model.Month" />
        </div>
        <button type="submit" class="btn-primary" style="padding:8px 16px;">Ver mes</button>
    </form>

    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
        <button type="button" class="btn-primary" style="padding:8px 16px;" onclick="window.print()">
            Imprimir / Guardar como PDF
        </button>

        @if (Model.Cases.Count > 0)
        {
            <form method="post" asp-page-handler="MarkPrinted"
                  onsubmit="return confirm('¿Vaciar el listado del mes @Model.Month? Se marcará como impreso.');">
                <input type="hidden" name="month" value="@Model.Month" />
                <button type="submit" class="nav-pill">Marcar como impresas</button>
            </form>
        }
    </div>
</div>

<div class="card documento">
    <header class="documento-encabezado">
        <div>
            <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="documento-logo" />
            <h1>F8 — Listado de penúltima carpeta</h1>
            <p class="documento-organismo">
                Ilustre Municipalidad de Valparaíso<br />
                Departamento de Licencias de Conducir
            </p>
        </div>
        <dl class="documento-datos">
            <dt>Período</dt><dd>@Model.Month</dd>
            <dt>Folio</dt><dd>@Model.Folio</dd>
            <dt>Fecha</dt><dd>@Model.GeneratedAt.ToString("dd-MM-yyyy")</dd>
            <dt>Solicita</dt><dd>@Model.OperatorName</dd>
            <dt>Total</dt><dd>@Model.Cases.Count carpeta(s)</dd>
        </dl>
    </header>

    <table class="cases documento-tabla">
        <thead>
            <tr>
                <th style="width:38px;">N°</th>
                <th>Nombre completo</th>
                <th>RUT</th>
                <th>Fecha penúltima carpeta</th>
            </tr>
        </thead>
        <tbody>
        @{ var numero = 1; }
        @foreach (var item in Model.Cases)
        {
            <tr>
                <td class="text-cell">@(numero++)</td>
                <td class="text-cell" style="text-align:left;">@item.NombreCompleto</td>
                <td class="text-cell">@LicenciasCarpetas.F8.Domain.RutFormatter.WithDots(item.Rut)</td>
                <td class="text-cell">@LicenciasCarpetas.F8.Domain.SpanishDateFormatter.LongDate(item.FechaPenultimaCarpeta)</td>
            </tr>
        }
        </tbody>
    </table>

    @if (Model.Cases.Count == 0)
    {
        <p class="text-md" style="padding:16px; text-align:center; color:var(--color-text-muted);">
            No hay carpetas completadas para el mes @Model.Month.
        </p>
    }

    <section class="documento-firmas">
        <div>
            <span class="documento-linea"></span>
            <p>Solicita — @Model.OperatorName<br /><small>Depto. Licencias de Conducir</small></p>
        </div>
    </section>
</div>
