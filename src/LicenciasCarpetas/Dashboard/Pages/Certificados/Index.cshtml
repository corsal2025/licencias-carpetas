@page
@model LicenciasCarpetas.Dashboard.Pages.Certificados.IndexModel
@{
    ViewData["Title"] = "Carpetas para Certificados";
    var currentTab = Model.Tab ?? "Todos";
}

<div class="card cd-filter-bar" style="padding:8px 14px; margin-bottom:10px; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
    <div style="display:flex; gap:6px; flex-wrap:wrap;">
        <a href="/Certificados/Index?tab=Todos" class="@(currentTab == "Todos" ? "active" : "")">Todos</a>
        <a href="/Certificados/Index?tab=Pendientes" class="@(currentTab == "Pendientes" ? "active" : "")">
            Pendientes (@Model.PendientesCount)
        </a>
        <a href="/Certificados/Index?tab=Emitidos" class="@(currentTab == "Emitidos" ? "active" : "")">
            Certificados Emitidos (@Model.EmitidosCount)
        </a>
    </div>
    <div style="margin-left:auto; display:flex; gap:16px; align-items:center;">
        <div style="display:flex; flex-direction:column; gap:4px; align-items:center; text-align:center;">
            <span style="font-weight:700; font-size:var(--font-xs); color:var(--color-primary); text-transform:uppercase; letter-spacing:0.6px; text-align:center; width:100%; display:block;">Informes</span>
            <div style="display:flex; gap:8px; align-items:center; justify-content:center;">
                <button type="button" onclick="window.print()" class="nav-pill nav-doc text-sm" style="border:none; cursor:pointer;">📄 Imprimir Listado</button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="card text-md @(Model.MessageIsError ? "message-error" : "")" style="margin-bottom:12px; padding:10px 14px; background:@(Model.MessageIsError ? "#fee2e2" : "#eef6ec"); border-left:4px solid @(Model.MessageIsError ? "#dc2626" : "#4a934a");">
        @Model.Message
    </div>
}

<form class="nav-search" method="get" action="/Certificados/Index" style="margin-bottom:12px;">
    <input type="hidden" name="tab" value="@currentTab" />
    <input type="text" name="search" value="@Model.Search" placeholder="Buscar por RUT, nombre o comuna..." />
    <button type="submit">Buscar</button>
    @if (!string.IsNullOrEmpty(Model.Search))
    {
        <a class="nav-search-clear" href="/Certificados/Index?tab=@currentTab">Limpiar búsqueda</a>
    }
</form>

<div class="card quick-add-card" style="margin-bottom:12px; padding:12px 16px;">
    <form method="post" asp-page-handler="AddManualCase" id="quick-add-form">
        <div style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
            <label style="display:flex; flex-direction:column; gap:4px; font-weight:600; font-size:12px;">
                Nombre completo
                <input class="input-block" name="nombreCompleto" placeholder="ej: Gustavo Peña Castro" style="padding:6px 10px; border-radius:6px; border:1px solid var(--color-border); font-size:13px;" required />
            </label>
            <label style="display:flex; flex-direction:column; gap:4px; font-weight:600; font-size:12px;">
                RUT
                <input class="input-block" name="rut" placeholder="ej: 18.785.387-7" style="padding:6px 10px; border-radius:6px; border:1px solid var(--color-border); font-size:13px;" required />
            </label>
            <label style="display:flex; flex-direction:column; gap:4px; font-weight:600; font-size:12px;">
                Comuna
                <input class="input-block" name="comuna" placeholder="ej: QUILPUÉ" style="padding:6px 10px; border-radius:6px; border:1px solid var(--color-border); font-size:13px;" />
            </label>
            <button type="submit" class="btn-primary" style="padding:7px 14px; font-weight:700; font-size:12px; border-radius:6px; height:33px;">
                + Agregar a Certificados
            </button>
        </div>
    </form>
</div>

<div class="card table-card">
    <table class="cases cases-list">
        <thead>
            <tr>
                <th style="text-align:center;">Marcar</th>
                <th style="text-align:center;">Pend.<br />carpeta</th>
                <th style="text-align:center;">Fecha Ingreso</th>
                <th>Nombre contribuyente</th>
                <th style="text-align:center;">RUT</th>
                <th style="text-align:center;">Comuna</th>
                <th style="text-align:center;">Estado</th>
                <th style="text-align:center;">Fecha Emisión</th>
                <th style="text-align:center;">Folio</th>
                <th style="text-align:center;">Acción</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Requests.Count == 0)
            {
                <tr>
                    <td colspan="10" style="text-align:center; padding:24px; color:var(--color-text-muted);">
                        No hay carpetas en esta bandeja de certificados.
                    </td>
                </tr>
            }
            @foreach (var request in Model.Requests)
            {
                var rowClass = request.Estado == "CERTIFICADO EMITIDO" ? "row-confirmed" : (request.PendienteCarpeta ? "row-pendiente-carpeta" : "");
                <tr class="@rowClass">
                    <td class="text-cell" style="text-align:center;">
                        <form class="toggle-form" method="post" asp-page-handler="ToggleMarked">
                            <input type="hidden" name="id" value="@request.Id" />
                            <input type="checkbox" class="marked-checkbox" name="markedValue" value="on" checked="@request.Marked" title="Marcar caso" onchange="this.form.submit()" />
                        </form>
                    </td>
                    <td class="text-cell" style="text-align:center;">
                        <form class="toggle-form" method="post" asp-page-handler="TogglePendienteCarpeta">
                            <input type="hidden" name="id" value="@request.Id" />
                            <input type="checkbox" class="pendiente-checkbox" name="pendienteCarpetaValue" value="on" checked="@request.PendienteCarpeta" title="Pendiente carpeta física" onchange="this.form.submit()" />
                        </form>
                    </td>
                    <td class="text-cell" style="text-align:center; font-family:var(--font-mono); font-size:12px;">
                        @request.FechaIngreso.ToString("dd-MM-yyyy")
                    </td>
                    <td class="name-cell" style="font-weight:600;">
                        @request.NombreCompleto
                    </td>
                    <td class="rut-cell" style="text-align:center; font-family:var(--font-mono); font-weight:600;">
                        @request.Rut
                    </td>
                    <td style="text-align:center; font-weight:700; text-transform:uppercase; color:var(--color-primary); font-size:12px;">
                        @request.Comuna
                    </td>
                    <td class="text-cell" style="text-align:center;">
                        @if (request.Estado == "CERTIFICADO EMITIDO")
                        {
                            <span class="badge" style="background:#d1fae5; color:#065f46; font-weight:800; font-size:11px; padding:4px 8px; border-radius:6px;">
                                ✓ EMITIDO
                            </span>
                        }
                        else
                        {
                            <span class="badge" style="background:#fef3c7; color:#92400e; font-weight:800; font-size:11px; padding:4px 8px; border-radius:6px;">
                                ⏳ PENDIENTE
                            </span>
                        }
                    </td>
                    <td style="text-align:center; font-family:var(--font-mono); font-size:12px;">
                        @(request.FechaEmision?.ToString("dd-MM-yyyy") ?? "—")
                    </td>
                    <td style="text-align:center; font-family:var(--font-mono); font-size:12px; font-weight:700;">
                        @(request.Folio ?? "—")
                    </td>
                    <td style="text-align:center; white-space:nowrap;">
                        <div style="display:inline-flex; gap:6px; align-items:center;">
                            <a asp-page="/Certificados/Emitir" asp-route-id="@request.Id" class="btn-cd-action certificado" style="text-decoration:none;" title="Generar e imprimir Certificado de Dirección">
                                📜 Emitir Certificado
                            </a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@request.Id" style="display:inline;"
                                  onsubmit="return confirm('¿Eliminar caso de certificados para @(request.NombreCompleto.Replace("'", "'"))?');">
                                <button type="submit" class="btn-cd-action btn-danger" style="background:#fee2e2; color:#b91c1c; border-color:#fca5a5;" title="Eliminar registro">
                                    🗑
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
