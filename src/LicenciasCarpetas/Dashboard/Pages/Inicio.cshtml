@page
@model LicenciasCarpetas.Dashboard.Pages.InicioModel
@{
    ViewData["Title"] = "Panel de Control Ejecutivo";
    var monthName = SpanishDate.MonthName(Model.CurrentMonth);
}

<div class="inicio-wrapper" style="padding-bottom: 70px;">

<div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:20px; flex-wrap:wrap; gap:10px;">
    <div>
        <h1 class="text-2xl" style="margin:0 0 4px; font-weight:700; color:var(--color-primary);">Panel de Control Ejecutivo</h1>
        <p class="text-md" style="margin:0; color:var(--color-text-muted);">Resumen operativo y métricas en tiempo real &bull; <strong>@monthName @Model.CurrentYear</strong></p>
    </div>
    <div style="display:flex; gap:8px;">
        <a asp-page="/Index" class="btn-primary" style="text-decoration:none; padding:8px 16px; font-weight:600;">🪪 Ver Casos</a>
        <a asp-page="/Estadisticas" class="nav-pill" style="text-decoration:none; padding:8px 14px;">📈 Estadísticas Detalladas</a>
    </div>
</div>

@if (Model.OverdueCasesCount > 0)
{
    <div class="card" style="background:var(--color-review-bg); border:1px solid var(--color-review-border); padding:12px 18px; margin-bottom:20px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">
        <div style="display:flex; align-items:center; gap:12px;">
            <span style="font-size:24px;">🚨</span>
            <div>
                <strong style="color:var(--color-review); font-size:var(--font-lg);">Atención: Hay @Model.OverdueCasesCount caso(s) con más de 15 días desde la citación</strong>
                <div style="color:var(--color-review); font-size:var(--font-sm);">Trámites pendientes fuera del plazo esperado que requieren resolución inmediata.</div>
            </div>
        </div>
        <a asp-page="/Index" asp-route-overdue="true" class="btn-danger" style="text-decoration:none; padding:6px 14px; font-weight:600;">Ver casos atrasados →</a>
    </div>
}

<div class="kpi-grid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:16px; margin-bottom:24px;">
    <div class="card kpi-card" style="border-left: 4px solid var(--color-primary-light); padding: 16px 18px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <span style="color:var(--color-text-muted); font-size:var(--font-sm); font-weight:700; text-transform:uppercase; letter-spacing: 0.5px;">Agenda Mes (@monthName)</span>
            <span class="badge-sla badge-sla-normal" style="background: var(--color-confirmed-bg); color: var(--color-confirmed);">Mes Actual</span>
        </div>
        <div style="font-size:var(--font-2xl); font-weight:800; color:var(--color-primary); margin:6px 0;">@(Model.MonthStats?.ScheduledTotal ?? 0)</div>
        <div class="text-sm" style="color:var(--color-text-muted);">
            Atendidos: <strong>@(Model.MonthStats?.AttendedTotal ?? 0)</strong>
            @if (Model.MonthStats?.AttendanceRate.HasValue == true)
            {
                <span class="badge-sla badge-sla-normal" style="margin-left:4px;">@Model.MonthStats.AttendanceRate.Value.ToString("P0")</span>
            }
        </div>
    </div>

    <div class="card kpi-card" style="border-left: 4px solid #15803d; padding: 16px 18px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <span style="color:var(--color-text-muted); font-size:var(--font-sm); font-weight:700; text-transform:uppercase; letter-spacing: 0.5px;">Subidas a Conaset</span>
            <span class="badge-sla badge-sla-normal">Conaset</span>
        </div>
        <div style="font-size:var(--font-2xl); font-weight:800; color:#15803d; margin:6px 0;">@(Model.MonthStats?.UploadedTotal ?? 0)</div>
        <div class="text-sm" style="color:var(--color-text-muted);">
            Escaneadas: <strong>@(Model.MonthStats?.ScannedTotal ?? 0)</strong>
        </div>
    </div>

    <div class="card kpi-card" style="border-left: 4px solid #b91c1c; padding: 16px 18px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <span style="color:var(--color-text-muted); font-size:var(--font-sm); font-weight:700; text-transform:uppercase; letter-spacing: 0.5px;">Alertas SLA (+15 días)</span>
            <span class="badge-sla badge-sla-overdue">Atención</span>
        </div>
        <div style="font-size:var(--font-2xl); font-weight:800; color:#b91c1c; margin:6px 0;">@Model.OverdueCasesCount</div>
        <div class="text-sm" style="color:var(--color-text-muted);">
            <a asp-page="/Index" asp-route-overdue="true" style="color:#b91c1c; font-weight:600; text-decoration:none;">Filtrar en Casos →</a>
        </div>
    </div>

    <div class="card kpi-card" style="border-left: 4px solid #b45309; padding: 16px 18px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <span style="color:var(--color-text-muted); font-size:var(--font-sm); font-weight:700; text-transform:uppercase; letter-spacing: 0.5px;">En Otra Comuna</span>
            <span class="badge-sla badge-sla-warning">Pendientes</span>
        </div>
        <div style="font-size:var(--font-2xl); font-weight:800; color:#b45309; margin:6px 0;">@Model.OtherComunaCount</div>
        <div class="text-sm" style="color:var(--color-text-muted);">
            <a asp-page="/Index" asp-route-otherComuna="true" style="color:#b45309; font-weight:600; text-decoration:none;">Ver solicitudes pendientes →</a>
        </div>
    </div>
</div>

<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(360px, 1fr)); gap:20px; margin-bottom:24px;">
    <!-- Gráfico 1: Estado de Carpetas en el Mes -->
    <div class="card" style="padding:18px;">
        <h3 class="text-lg" style="margin:0 0 14px; font-weight:700;">Distribución de Estados (@monthName @Model.CurrentYear)</h3>
        @{
            var states = Model.MonthStats?.FolderStates.Where(s => s.State != null).ToList() ?? [];
            var totalStateCases = Math.Max(1, states.Sum(s => s.Count));
        }
        @if (states.Count == 0)
        {
            <p style="color:var(--color-text-muted); font-size:var(--font-sm); padding:20px 0; text-align:center;">Sin movimientos registrados este mes.</p>
        }
        else
        {
            <div style="display:flex; flex-direction:column; gap:10px;">
                @foreach (var st in states.OrderByDescending(s => s.Count).Take(6))
                {
                    var pct = (double)st.Count / totalStateCases * 100;
                    var displayName = FolderStateCatalog.Display(st.State!.Value);
                    var isSuccess = st.State.Value.ToString().Contains("Subida");
                    var barColor = isSuccess ? "#2f9e6e" : (st.State.Value == FolderState.NoExisteCarpeta ? "#e0605f" : "#3b6fe0");
                    <div>
                        <div style="display:flex; justify-content:space-between; font-size:var(--font-sm); margin-bottom:3px;">
                            <span style="font-weight:600;">@displayName</span>
                            <span style="color:var(--color-text-muted);">@st.Count (@pct.ToString("F0")%)</span>
                        </div>
                        <div style="background:#e2e8f0; border-radius:4px; height:8px; overflow:hidden;">
                            <div style="background:@barColor; width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; height:100%; border-radius:4px;"></div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Gráfico 2: Carga por Oficina -->
    <div class="card" style="padding:18px;">
        <h3 class="text-lg" style="margin:0 0 14px; font-weight:700;">Carga Operativa por Oficina</h3>
        @{
            var offices = Enum.GetValues<Office>();
            var maxScheduled = Math.Max(1, offices.Max(o => Model.MonthStats?.ScheduledFor(o) ?? 0));
        }
        <div style="display:flex; flex-direction:column; gap:12px;">
            @foreach (var office in offices)
            {
                var sch = Model.MonthStats?.ScheduledFor(office) ?? 0;
                var att = Model.MonthStats?.AttendedFor(office) ?? 0;
                var pct = (double)sch / maxScheduled * 100;
                <div style="background:#f8fafc; padding:10px 12px; border-radius:var(--radius); border:1px solid var(--color-border);">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                        <strong style="font-size:var(--font-sm);">@OfficeCatalog.Display(office)</strong>
                        <span class="badge-sla badge-sla-normal">@att / @sch citados</span>
                    </div>
                    <div style="background:#e2e8f0; border-radius:6px; height:10px; overflow:hidden;">
                        <div style="background:var(--color-primary); width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; height:100%;" title="Citados: @sch"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Accesos a Módulos Integrados -->
<h3 class="text-lg" style="margin:0 0 12px; font-weight:700;">Módulos Integrados</h3>
<div class="hub-grid" style="grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));">
    <div class="card hub-card">
        <h2 class="text-lg" style="margin:0;">🪪 Gestión de Licencias</h2>
        <div class="hub-card-count">@Model.CasosCount</div>
        <p class="text-md" style="margin:0; color:var(--color-text-muted);">casos totales en sistema</p>
        <a asp-page="/Index" class="hub-card-link">Acceder al módulo →</a>
    </div>

    @if (Model.PuedeCambioDomicilio)
    {
        <div class="card hub-card">
            <h2 class="text-lg" style="margin:0;">📥 Cambio de Domicilio</h2>
            <div class="hub-card-count">@Model.CambioDomicilioPendientes</div>
            <p class="text-md" style="margin:0; color:var(--color-text-muted);">solicitudes pendientes</p>
            <a asp-page="/CambioDomicilio/Index" class="hub-card-link">Acceder al módulo →</a>
            @if (Model.EwsStatus is { } ews)
            {
                var (icono, texto) = ews.Health switch
                {
                    LicenciasCarpetas.CambioDomicilio.Ews.EwsHealth.Ok => ("🟢", "Correo institucional conectado"),
                    LicenciasCarpetas.CambioDomicilio.Ews.EwsHealth.Failed => ("🔴", "Correo institucional sin conexión"),
                    LicenciasCarpetas.CambioDomicilio.Ews.EwsHealth.NotConfigured => ("⚪", "Correo institucional sin configurar"),
                    _ => ("⚪", "Correo institucional sin verificar")
                };
                <div class="ews-status" style="margin-top:8px; font-size:var(--font-sm);">
                    <strong>@icono @texto</strong>
                    @if (ews.CheckedAt is { } at)
                    {
                        <span style="color:var(--color-text-muted);"> · @at.ToString("dd-MM HH:mm")</span>
                    }
                    @if (ews.Detail is not null)
                    {
                        <div style="color:var(--color-text-muted);">@ews.Detail</div>
                    }
                    @if (ews.Health != LicenciasCarpetas.CambioDomicilio.Ews.EwsHealth.NotConfigured)
                    {
                        <form method="post" asp-page-handler="CheckEws" style="margin-top:4px;">
                            <button type="submit" class="nav-pill" style="cursor:pointer;">Verificar correo</button>
                        </form>
                    }
                </div>
            }
        </div>
    }

    @if (Model.PuedeF8)
    {
        <div class="card hub-card">
            <h2 class="text-lg" style="margin:0;">🚨 F8 Urgentes</h2>
            <div class="hub-card-count">@Model.F8Count</div>
            <p class="text-md" style="margin:0; color:var(--color-text-muted);">solicitudes en proceso</p>
            <a asp-page="/F8/Index" class="hub-card-link">Acceder al módulo →</a>
        </div>
    }
</div>
</div> <!-- Fin de inicio-wrapper -->
