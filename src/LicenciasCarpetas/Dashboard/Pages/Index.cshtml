@section Scripts {
<script>
    // El color de la fila lo pinta el servidor al cargar, según el estado guardado. Al elegir otra
    // opción, el color tiene que cambiar en el acto: esperar a guardar deja la fila mostrando el
    // color del estado anterior, que es exactamente lo que el operador usa para leer la agenda.
    // El campo Comuna vive en el form de "Guardar" de cada fila, no en el de "Solicitar" —
    // sin esto, tipear la comuna y apretar Solicitar sin guardar antes mandaba el valor viejo (o
    // vacío) que había en la base, y la solicitud no se creaba. Copia el valor actual del input
    // al hidden del form de Solicitar justo antes de enviarlo, para que un solo clic alcance.
    function prepararSolicitar(form) {
        var comunaId = form.dataset.solicitarComunaId;
        var comunaInput = comunaId ? document.getElementById(comunaId) : null;
        var comunaHidden = form.querySelector('input[name="comuna"]');
        if (comunaHidden) {
            comunaHidden.value = comunaInput ? comunaInput.value : '';
        }
        var estadoId = form.dataset.solicitarEstadoId;
        var estadoSelect = estadoId ? document.getElementById(estadoId) : null;
        var estadoHidden = form.querySelector('input[name="estado"]');
        if (estadoHidden) {
            estadoHidden.value = estadoSelect ? estadoSelect.value : '';
        }
        var fullName = form.dataset.solicitarFullname || '';
        return confirm('Esto crea una solicitud de Cambio de Domicilio para ' + fullName + ' y manda el correo a la comuna de inmediato. ¿Confirmar?');
    }

    // El botón "Solicitar" tiene que aparecer apenas se elige "Cambio de domicilio solicitado" en
    // el desplegable, no recién después de Guardar y recargar la página — si no, elegir la opción
    // no muestra nada y parece que el sistema no hizo nada.
    function toggleSolicitarForm(select) {
        var row = select.closest('tr');
        if (!row) return;
        var form = row.querySelector('.solicitar-form');
        if (!form) return;
        form.style.display = select.value === 'CambioDomicilioSolicitado' ? 'inline' : 'none';
    }

    function repaintRow(select) {
        var row = select.closest('tr');
        if (!row) return;

        row.className = row.className
            .split(' ')
            .filter(function (c) { return c && c.indexOf('estado-') !== 0; })
            .join(' ');

        if (select.value) {
            row.classList.add('estado-' + select.value.toLowerCase());
        }

        var isUpload = uploadStates.indexOf(select.value) !== -1;
        fillUploadDateIfMissing(row, isUpload);
        toggleSolicitarForm(select);
        markUnsaved(select);
        autoSaveCaseRow(select);
    }

    // Mismo criterio que el servidor (OnPostSave): elegir un estado de "ya subida" o una decisión final
    // (OTORGADO, DENEGADO, etc.) escribe la fecha de hoy en Subida carpeta, salvo que ya tenga una.
    var uploadStates = ['SubidaAConaset', 'SubidaConF8', 'SubidaConOficio',
        'CambioDomicilioSubidoAConaset', 'CambioDomicilioSubidoConCorreo'];
    var spanishMonths = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
        'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];

    function fillUploadDateIfMissing(row, shouldFill) {
        var subidaInput = row.querySelector('input[name="subida"]');
        if (!subidaInput) return;

        if (!shouldFill) {
            if (subidaInput.dataset.autofilled === 'true') {
                subidaInput.value = '';
                delete subidaInput.dataset.autofilled;
                markUnsaved(subidaInput);
            }
            return;
        }

        if (subidaInput.value.trim() !== '') return;

        var today = new Date();
        subidaInput.value = today.getDate() + '/' + spanishMonths[today.getMonth()] + '/' + today.getFullYear();
        subidaInput.dataset.autofilled = 'true';
        markUnsaved(subidaInput);
    }

    function onDecisionChanged(select) {
        var row = select.closest('tr');
        if (!row) return;
        if (select.value) {
            fillUploadDateIfMissing(row, true);
        }
        markUnsaved(select);
        autoSaveCaseRow(select);
    }

    // Cambiar el desplegable no guarda nada: sin este aviso, el color nuevo hace creer que sí.
    function markUnsaved(field) {
        var row = field.closest('tr');
        if (row) row.classList.add('fila-sin-guardar');
    }

    // Igual que repaintRow con el estado de la carpeta: sin esto, el parpadeo y el ícono junto al
    // nombre solo aparecían después de guardar y recargar, y el operador no tenía forma de saber que
    // la selección "prendió" hasta ese momento.
    var idoneidadIcons = { Alertada: '🚨', Revisar: '⚠️', Aceptada: '✅' };
    var idoneidadTitles = { Alertada: 'Idoneidad moral: ALERTADA', Revisar: 'Idoneidad moral: REVISAR', Aceptada: 'Idoneidad moral: ACEPTADA' };

    function repaintIdoneidad(select) {
        var row = select.closest('tr');
        if (!row) return;

        row.classList.remove('row-alertada', 'row-revisar');
        if (select.value && select.value !== 'Aceptada') {
            row.classList.add('row-' + select.value.toLowerCase());
        }

        var nameCell = row.querySelector('.name-cell');
        if (nameCell) {
            var existing = nameCell.querySelector('.idoneidad-icon');
            if (existing) existing.remove();

            if (select.value && idoneidadIcons[select.value]) {
                var icon = document.createElement('span');
                icon.className = 'idoneidad-icon';
                icon.title = idoneidadTitles[select.value];
                icon.textContent = idoneidadIcons[select.value];
                nameCell.insertBefore(icon, nameCell.firstChild);
            }
        }

        markUnsaved(select);
        autoSaveCaseRow(select);
    }

    // Alterna la clase que hace parpadear las filas en ALERTADA. Va en <body>, no por fila: así una
    // fila que pasa a ALERTADA después de cargada (repaintIdoneidad) también parpadea sin más código.
    setInterval(function () {
        document.body.classList.toggle('idoneidad-flash');
    }, 500);

    var SPANISH_MONTHS = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
    var SPANISH_MONTHS_DICT = {
        'enero': 1, 'febrero': 2, 'marzo': 3, 'abril': 4, 'mayo': 5, 'junio': 6,
        'julio': 7, 'agosto': 8, 'septiembre': 9, 'setiembre': 9, 'octubre': 10,
        'noviembre': 11, 'diciembre': 12
    };

    function formatSpanishDate(str) {
        if (!str || !str.trim()) return '';
        var text = str.trim();
        var parts = text.split(/[\s\/\-\.]+/).filter(function(p) {
            return p && p.toLowerCase() !== 'de' && p.toLowerCase() !== 'del';
        });
        if (parts.length === 3) {
            var day = parseInt(parts[0], 10);
            var month = -1;
            var mStr = parts[1].toLowerCase();
            if (SPANISH_MONTHS_DICT[mStr]) {
                month = SPANISH_MONTHS_DICT[mStr] - 1;
            } else {
                for (var i = 0; i < SPANISH_MONTHS.length; i++) {
                    if (SPANISH_MONTHS[i].startsWith(mStr)) {
                        month = i;
                        break;
                    }
                }
                if (month === -1) {
                    var mNum = parseInt(parts[1], 10);
                    if (mNum >= 1 && mNum <= 12) month = mNum - 1;
                }
            }
            var year = parseInt(parts[2], 10);
            if (year < 100) year += (year >= 50 ? 1900 : 2000);
            if (!isNaN(day) && month >= 0 && !isNaN(year) && day >= 1 && day <= 31 && year >= 1900 && year <= 2100) {
                return day + '/' + SPANISH_MONTHS[month] + '/' + year;
            }
        }
        return text;
    }

    // ── Autoguardado Instantáneo por AJAX (ENTER y cambio de celda) ───────────────
    async function autoSaveCaseRow(field) {
        var row = field.closest('tr');
        if (!row) return;

        var form = row.querySelector('form[id^="case-form-"]');
        if (!form) return;

        var dateFields = ['citacion', 'subida', 'ultimaCarpeta', 'penultima'];
        if (dateFields.indexOf(field.name) !== -1) {
            var formatted = formatSpanishDate(field.value);
            if (formatted && formatted !== field.value) {
                field.value = formatted;
                if (field.name === 'ultimaCarpeta') updateSectorCellInRealtime(field);
            }
        }

        var formData = new FormData(form);

        var rowInputs = row.querySelectorAll('input:not([type=checkbox]), select, textarea');
        rowInputs.forEach(function (el) {
            if (el.name && el.name !== '__RequestVerificationToken') {
                formData.set(el.name, el.value);
            }
        });

        row.classList.remove('fila-sin-guardar', 'fila-guardada-ok');
        row.classList.add('fila-guardando');

        try {
            var url = form.getAttribute('action') || (window.location.pathname + window.location.search);
            var response = await fetch(url, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            if (response.ok) {
                try {
                    var resJson = await response.json();
                    if (resJson && resJson.ok) {
                        if (resJson.citacion !== undefined) {
                            var inp = row.querySelector('input[name="citacion"]');
                            if (inp && document.activeElement !== inp) inp.value = resJson.citacion;
                        }
                        if (resJson.subida !== undefined) {
                            var inp = row.querySelector('input[name="subida"]');
                            if (inp && document.activeElement !== inp) inp.value = resJson.subida;
                        }
                        if (resJson.ultimaCarpeta !== undefined) {
                            var inp = row.querySelector('input[name="ultimaCarpeta"]');
                            if (inp && document.activeElement !== inp) inp.value = resJson.ultimaCarpeta;
                        }
                        if (resJson.penultima !== undefined) {
                            var inp = row.querySelector('input[name="penultima"]');
                            if (inp && document.activeElement !== inp) inp.value = resJson.penultima;
                        }
                    }
                } catch (_) {}

                row.classList.remove('fila-guardando', 'fila-sin-guardar');
                row.classList.add('fila-guardada-ok');
                setTimeout(function () {
                    row.classList.remove('fila-guardada-ok');
                }, 1200);
            } else {
                row.classList.remove('fila-guardando');
                row.classList.add('fila-sin-guardar');
            }
        } catch (e) {
            console.error('Error autoguardando caso:', e);
            row.classList.remove('fila-guardando');
            row.classList.add('fila-sin-guardar');
        }
    }

    function updateSectorCellInRealtime(input) {
        if (input.name !== 'ultimaCarpeta') return;
        var row = input.closest('tr');
        if (!row) return;
        var sectorCell = row.querySelector('.sector-cell');
        if (!sectorCell) return;

        var val = (input.value || '').trim();
        if (!val) {
            sectorCell.textContent = '—';
            return;
        }

        var parts = val.split(/[\/\-\. ]+/).filter(function(p) { 
            return p && p.toLowerCase() !== 'de' && p.toLowerCase() !== 'del'; 
        });

        if (parts.length === 3) {
            var day = parseInt(parts[0], 10);
            var month = parseInt(parts[1], 10);
            var year = parseInt(parts[2], 10);

            var monthNames = { 
                'enero':1, 'febrero':2, 'marzo':3, 'abril':4, 'mayo':5, 'junio':6, 
                'julio':7, 'agosto':8, 'septiembre':9, 'setiembre':9, 'octubre':10, 
                'noviembre':11, 'diciembre':12 
            };
            if (isNaN(month) && monthNames[parts[1].toLowerCase()]) {
                month = monthNames[parts[1].toLowerCase()];
            }

            if (year < 100) year += (year >= 50 ? 1900 : 2000);

            if (!isNaN(day) && !isNaN(month) && !isNaN(year) && month >= 1 && month <= 12 && day >= 1 && day <= 31) {
                var d = new Date(year, month - 1, day);
                var cutoff = new Date(2023, 6, 1); // 1 de Julio de 2023
                if (d < cutoff) {
                    sectorCell.textContent = 'Archivo';
                } else {
                    sectorCell.textContent = 'Oficina 43';
                }
                return;
            }
        }

        sectorCell.textContent = '—';
    }

    document.querySelectorAll('table.cases-index tbody input, table.cases-index tbody select')
        .forEach(function (field) {
            if (field.type === 'checkbox') return;

            var dateFields = ['citacion', 'subida', 'ultimaCarpeta', 'penultima'];

            field.addEventListener('input', function () {
                if (field.name === 'subida') delete field.dataset.autofilled;
                if (field.name === 'ultimaCarpeta') updateSectorCellInRealtime(field);
                markUnsaved(field);
            });

            field.addEventListener('blur', function () {
                if (dateFields.indexOf(field.name) !== -1) {
                    var fmt = formatSpanishDate(field.value);
                    if (fmt && fmt !== field.value) {
                        field.value = fmt;
                        if (field.name === 'ultimaCarpeta') updateSectorCellInRealtime(field);
                        autoSaveCaseRow(field);
                    }
                }
            });

            field.addEventListener('change', function () {
                if (field.name === 'ultimaCarpeta') updateSectorCellInRealtime(field);
                autoSaveCaseRow(field);
            });

            field.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    if (dateFields.indexOf(field.name) !== -1) {
                        var fmt = formatSpanishDate(field.value);
                        if (fmt && fmt !== field.value) {
                            field.value = fmt;
                            if (field.name === 'ultimaCarpeta') updateSectorCellInRealtime(field);
                        }
                    }
                    autoSaveCaseRow(field);

                    var allInputs = Array.from(document.querySelectorAll('table.cases-index tbody input:not([type=hidden]):not([type=checkbox]), table.cases-index tbody select'));
                    var currIndex = allInputs.indexOf(field);
                    if (currIndex >= 0 && currIndex < allInputs.length - 1) {
                        var nextInput = allInputs[currIndex + 1];
                        nextInput.focus();
                        if (nextInput.select) nextInput.select();
                    }
                }
            });
        });

    // ── Popover Flotante de Observaciones (Portal Independiente) ────────────────
    var activeObsCaseId = null;
    var activeObsTriggerBtn = null;

    function toggleObsPopover(btn, caseId) {
        var popover = document.getElementById('obs-floating-popover');
        if (!popover) return;

        if (activeObsCaseId === caseId && popover.style.display !== 'none') {
            saveAndCloseObsPopover();
            return;
        }

        if (activeObsCaseId && popover.style.display !== 'none') {
            saveAndCloseObsPopover();
        }

        activeObsCaseId = caseId;
        activeObsTriggerBtn = btn;

        var row = btn.closest('tr');
        var rowTextarea = row ? row.querySelector('textarea[name="observaciones"]') : null;
        var nameInput = row ? row.querySelector('input[name="nombre"]') : null;
        var fullName = nameInput ? nameInput.value.trim() : ('Caso #' + caseId);
        var currentVal = rowTextarea ? rowTextarea.value : '';

        var titleSpan = document.getElementById('obs-popover-title');
        if (titleSpan) titleSpan.textContent = 'Observación — ' + (fullName || 'Caso #' + caseId);

        var ta = document.getElementById('obs-popover-textarea');
        if (ta) {
            ta.value = currentVal;
        }

        popover.style.display = 'flex';
        positionObsFloatingPopover();

        if (ta) {
            ta.focus({ preventScroll: true });
        }
    }

    function positionObsFloatingPopover() {
        var popover = document.getElementById('obs-floating-popover');
        if (!popover || popover.style.display === 'none' || !activeObsTriggerBtn) return;

        var rect = activeObsTriggerBtn.getBoundingClientRect();
        var ancho = 320;
        var alto = 190;

        var cabeADerecha = (rect.right + 8 + ancho) <= window.innerWidth;
        var left = cabeADerecha ? (rect.right + 8) : Math.max(10, rect.left - ancho - 8);
        if (!cabeADerecha && left < 10) {
            left = Math.max(10, window.innerWidth - ancho - 10);
        }

        var top = rect.top - 10;
        if (top + alto > window.innerHeight - 10) {
            top = Math.max(10, window.innerHeight - alto - 10);
        }
        if (top < 10) top = 10;

        popover.style.top = Math.round(top) + 'px';
        popover.style.left = Math.round(left) + 'px';
    }

    function closeObsPopover() {
        var popover = document.getElementById('obs-floating-popover');
        if (popover) popover.style.display = 'none';
        activeObsCaseId = null;
        activeObsTriggerBtn = null;
    }

    function saveAndCloseObsPopover() {
        if (!activeObsCaseId || !activeObsTriggerBtn) {
            closeObsPopover();
            return;
        }
        var popover = document.getElementById('obs-floating-popover');
        var ta = document.getElementById('obs-popover-textarea');
        var newVal = ta ? ta.value : '';

        var row = activeObsTriggerBtn.closest('tr');
        if (row) {
            var rowTextarea = row.querySelector('textarea[name="observaciones"]');
            if (rowTextarea) {
                rowTextarea.value = newVal;
                markUnsaved(rowTextarea);
            }
            activeObsTriggerBtn.textContent = newVal.trim().length > 0 ? '🗒️' : '📝';
            if (newVal.trim().length > 0) {
                activeObsTriggerBtn.classList.add('has-obs');
            } else {
                activeObsTriggerBtn.classList.remove('has-obs');
            }
            var form = row.querySelector('form[id^="case-form-"]');
            if (form) autoSaveCaseForm(form);
        }
        closeObsPopover();
    }

    // Escucha de escritura en el popover de observaciones
    (function () {
        var popoverTa = document.getElementById('obs-popover-textarea');
        if (popoverTa) {
            popoverTa.addEventListener('input', function () {
                if (!activeObsTriggerBtn) return;
                var row = activeObsTriggerBtn.closest('tr');
                if (row) {
                    var rowTextarea = row.querySelector('textarea[name="observaciones"]');
                    if (rowTextarea) {
                        rowTextarea.value = popoverTa.value;
                        markUnsaved(rowTextarea);
                    }
                    activeObsTriggerBtn.textContent = popoverTa.value.trim().length > 0 ? '🗒️' : '📝';
                }
            });
        }
    })();

    // ── Popover Flotante de Selección de Licencias (Portal Independiente) ────────
    var activeLicCaseId = null;
    var activeLicTriggerBtn = null;

    function openLicenciasPopover(btn, caseId) {
        var popover = document.getElementById('licencias-floating-popover');
        if (!popover) return;

        if (activeLicCaseId === caseId && popover.style.display !== 'none') {
            closeLicenciasPopover();
            return;
        }

        activeLicCaseId = caseId;
        activeLicTriggerBtn = btn;

        var row = btn.closest('tr');
        var nameInput = row ? row.querySelector('input[name="nombre"]') : null;
        var fullName = nameInput ? nameInput.value.trim() : ('Caso #' + caseId);

        var titleSpan = document.getElementById('licencias-popover-title');
        if (titleSpan) titleSpan.textContent = fullName ? ('Licencias — ' + fullName) : 'Clases de Licencia';

        var hidden = document.getElementById('lic-hidden-' + caseId);
        var storedVal = hidden ? hidden.value : (btn.getAttribute('data-licencias') || '');
        var activeClasses = storedVal.split(',').map(function (s) { return s.trim(); }).filter(function (s) { return s.length > 0; });

        popover.querySelectorAll('.lic-popover-cb').forEach(function (cb) {
            cb.checked = activeClasses.indexOf(cb.value) !== -1;
        });

        popover.style.display = 'flex';
        positionLicenciasFloatingPopover();
    }

    function positionLicenciasFloatingPopover() {
        var popover = document.getElementById('licencias-floating-popover');
        if (!popover || popover.style.display === 'none' || !activeLicTriggerBtn) return;

        var rect = activeLicTriggerBtn.getBoundingClientRect();
        var ancho = 210;
        var alto = 220;

        var left = rect.left;
        if (left + ancho > window.innerWidth - 10) {
            left = Math.max(10, window.innerWidth - ancho - 10);
        }

        var top = rect.bottom + 4;
        if (top + alto > window.innerHeight - 10) {
            top = Math.max(10, rect.top - alto - 4);
        }

        popover.style.top = Math.round(top) + 'px';
        popover.style.left = Math.round(left) + 'px';
    }

    function closeLicenciasPopover() {
        var popover = document.getElementById('licencias-floating-popover');
        if (popover) popover.style.display = 'none';
        activeLicCaseId = null;
        activeLicTriggerBtn = null;
    }

    function onLicenciaPopoverChange() {
        if (!activeLicCaseId || !activeLicTriggerBtn) return;

        var popover = document.getElementById('licencias-floating-popover');
        var checked = [];
        popover.querySelectorAll('.lic-popover-cb:checked').forEach(function (cb) {
            checked.push(cb.value);
        });

        var serialized = checked.join(',');
        var displayText = checked.length > 0 ? checked.join(', ') : '—';

        activeLicTriggerBtn.setAttribute('data-licencias', serialized);
        var textSpan = activeLicTriggerBtn.querySelector('.lic-btn-text');
        if (textSpan) textSpan.textContent = displayText;

        var hidden = document.getElementById('lic-hidden-' + activeLicCaseId);
        if (hidden) {
            hidden.value = serialized;
        }

        var row = activeLicTriggerBtn.closest('tr');
        if (row) {
            var form = row.querySelector('form[id^="case-form-"]');
            if (form) autoSaveCaseForm(form);
        }
    }

    // Cerrar y reposicionar eventos globales
    document.addEventListener('mousedown', function (event) {
        var obsPopover = document.getElementById('obs-floating-popover');
        if (obsPopover && obsPopover.style.display !== 'none') {
            if (!obsPopover.contains(event.target) && (!activeObsTriggerBtn || !activeObsTriggerBtn.contains(event.target))) {
                saveAndCloseObsPopover();
            }
        }
        var licPopover = document.getElementById('licencias-floating-popover');
        if (licPopover && licPopover.style.display !== 'none') {
            if (!licPopover.contains(event.target) && (!activeLicTriggerBtn || !activeLicTriggerBtn.contains(event.target))) {
                closeLicenciasPopover();
            }
        }
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            closeObsPopover();
            closeLicenciasPopover();
        }
    });

    function reposicionarTodo() {
        positionObsFloatingPopover();
        positionLicenciasFloatingPopover();
    }

    var tableCard = document.querySelector('.table-card');
    if (tableCard) {
        tableCard.addEventListener('scroll', reposicionarTodo, { passive: true });
    }
    window.addEventListener('scroll', reposicionarTodo, { passive: true });
    window.addEventListener('resize', reposicionarTodo, { passive: true });

    // ── Columnas Fijas (Sticky) hasta el RUT ─────────────────────────────────────
    (function () {
        var table = document.querySelector('table.cases-index');
        if (!table) return;

        function updateStickyColumns() {
            var colMarcar = table.querySelector('thead th.col-sticky-marcar');
            var colCitacion = table.querySelector('thead th.col-sticky-citacion');
            var colNombre = table.querySelector('thead th.col-sticky-nombre');

            if (!colMarcar || !colCitacion || !colNombre) return;

            var wMarcar = colMarcar.getBoundingClientRect().width;
            var wCitacion = colCitacion.getBoundingClientRect().width;
            var wNombre = colNombre.getBoundingClientRect().width;

            var citacionLeft = Math.round(wMarcar);
            var nombreLeft = Math.round(citacionLeft + wCitacion);
            var rutLeft = Math.round(nombreLeft + wNombre);

            table.style.setProperty('--sticky-citacion-left', citacionLeft + 'px');
            table.style.setProperty('--sticky-nombre-left', nombreLeft + 'px');
            table.style.setProperty('--sticky-rut-left', rutLeft + 'px');
        }

        updateStickyColumns();
        window.addEventListener('resize', updateStickyColumns);
        if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(updateStickyColumns);
        }
        setTimeout(updateStickyColumns, 100);
        setTimeout(updateStickyColumns, 500);
    })();
</script>
<script>
    // Checkbox toggles go through fetch() so ticking several rows quickly cannot cancel each other
    // the way competing full-page navigations do. The checkbox belongs to bulk-delete-form (via
    // its own form= attribute), so the marked-form that actually persists Marked is passed in
    // explicitly rather than read off checkbox.form.
    function toggleRowMark(checkbox, markedForm) {
        var row = checkbox.closest('tr');
        if (row) {
            row.classList.toggle('row-selected', checkbox.checked);
        }
        var id = markedForm.querySelector('input[name="id"]').value;
        var token = markedForm.querySelector('input[name="__RequestVerificationToken"]').value;
        var body = '__RequestVerificationToken=' + encodeURIComponent(token) + '&id=' + encodeURIComponent(id);
        if (checkbox.checked) {
            body += '&markedValue=true';
        }
        fetch(markedForm.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body
        });
    }
</script>
<script>
    // Autoguardado de la fila: elegir un estado, tipear/borrar un dato o tildar una licencia manda
    // el form entero (case-form-ID de la fila) por fetch(), sin recargar la página — el operador no
    // tiene que ir fila por fila apretando "Guardar" para poder seguir con la siguiente. El botón
    // "Guardar" sigue ahí y sigue funcionando igual que antes (navegación normal), por si alguien
    // prefiere confirmar a mano o el fetch falla.
    // Un solo listener delegado en la tabla, no uno por cada input de cada fila (serían más de
    // 1000 con 100 filas x 13 columnas editables) — "change" ya cubre selects/checkboxes al elegir
    // y campos de texto al perder el foco con el valor cambiado, sin necesitar además "blur"/"focusout".
    var autoSaveTimers = {};
    // Un solo fetch en vuelo por fila: si una segunda edición dispara un nuevo guardado mientras el
    // anterior todavía no responde (servidor lento, dos campos tocados con más de 400ms de
    // diferencia), el anterior se cancela con AbortController en vez de dejarlo terminar. Sin esto,
    // dos respuestas podían llegar en cualquier orden y la más vieja (con datos desactualizados)
    // podía pisar a la más nueva en la base sin que la fila mostrara ningún error — cada request
    // manda el form ENTERO, así que solo importa que el último en llegar sea siempre el último en
    // salir.
    var autoSaveControllers = {};

    function onLicenciaCheckboxChange(checkbox, caseId) {
        var details = checkbox.closest('.licencias-celda');
        if (details) {
            var summary = details.querySelector('summary');
            var checkedBoxes = details.querySelectorAll('input[name="licencias"]:checked');
            var selected = [];
            checkedBoxes.forEach(function (cb) {
                selected.push(cb.value);
            });
            if (summary) {
                summary.textContent = selected.length > 0 ? selected.join(', ') : '—';
            }
        }
        var form = document.getElementById('case-form-' + caseId);
        if (form) {
            autoSaveCaseForm(form);
        }
    }

    function autoSaveCaseForm(form) {
        var row = form.closest('tr');
        if (row) {
            row.classList.add('fila-sin-guardar');
            row.classList.remove('fila-error-guardado');
        }
        var formId = form.id;
        if (autoSaveTimers[formId]) {
            clearTimeout(autoSaveTimers[formId]);
        }
        autoSaveTimers[formId] = setTimeout(function () { sendAutoSave(form); }, 300);
    }

    function sendAutoSave(form) {
        var formId = form.id;
        var row = form.closest('tr');
        var formData = new FormData(form);

        if (row) {
            // Asegurar recolección de todos los inputs asociados a este formulario por ID
            var licenceInputs = row.querySelectorAll('input[name="licencias"]');
            if (licenceInputs.length > 0) {
                formData.delete('licencias');
                licenceInputs.forEach(function(cb) {
                    if (cb.checked) {
                        formData.append('licencias', cb.value);
                    }
                });
            }
        }

        var body = new URLSearchParams(formData).toString();

        if (autoSaveControllers[formId]) {
            autoSaveControllers[formId].abort();
        }
        var controller = new AbortController();
        autoSaveControllers[formId] = controller;

        fetch(form.action, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: body,
            signal: controller.signal
        }).then(function (response) {
            if (!response.ok) throw new Error('HTTP ' + response.status);
            return response.json();
        }).then(function (data) {
            if (autoSaveControllers[formId] === controller) autoSaveControllers[formId] = null;
            if (!row) return;
            if (data && data.isError) {
                row.classList.add('fila-error-guardado');
                row.title = data.message || '';
            } else {
                row.classList.remove('fila-sin-guardar', 'fila-error-guardado');
                row.title = '';
            }
        }).catch(function (err) {
            // AbortError: este request lo canceló uno más nuevo para la misma fila — el que sigue
            // en vuelo es el que manda, no hay nada que reportar acá.
            if (err && err.name === 'AbortError') return;
            if (autoSaveControllers[formId] === controller) autoSaveControllers[formId] = null;
            // Sin conexión o error del servidor: la fila queda marcada como pendiente (borde
            // naranja ya puesto arriba) más un aviso en rojo — silenciar esto haría creer que se
            // guardó cuando en realidad el cambio solo vive en el navegador.
            if (row) {
                row.classList.add('fila-error-guardado');
                row.title = 'No se pudo guardar — revise la conexión e intente de nuevo.';
            }
        });
    }

    document.addEventListener('change', function (e) {
        var target = e.target;
        var formId = target.getAttribute && target.getAttribute('form');
        if (!formId || formId.indexOf('case-form-') !== 0) return;
        var form = document.getElementById(formId);
        if (!form) return;
        autoSaveCaseForm(form);
    });

    // Sin botón "Guardar" visible, apretar Enter en un input de texto de la fila (Código F8,
    // Fecha penúltima carpeta, Nombre, RUT, etc.) dispara el envío nativo e implícito del form
    // — una navegación de página completa que reventaba el autoguardado por fetch() y hacía
    // "saltar" la página al principio, perdiendo el scroll. Se intercepta y se manda por el mismo
    // camino que change/blur, guardando igual sin recargar nada.
    document.addEventListener('submit', function (e) {
        if (e.target.id && e.target.id.indexOf('case-form-') === 0) {
            e.preventDefault();
            autoSaveCaseForm(e.target);
        }
    });
</script>
<script>
    // Borrado masivo: el botón queda deshabilitado hasta marcar al menos una fila, y el checkbox
    // del encabezado marca/desmarca todas las visibles de una sola vez.
    (function () {
        var selectAll = document.getElementById('select-all-rows');
        var deleteBtn = document.getElementById('bulk-delete-btn');
        var countLabel = document.getElementById('bulk-delete-count');
        var rowCheckboxes = Array.from(document.querySelectorAll('.bulk-select-checkbox'));
        if (!deleteBtn) return;

        function updateState() {
            var checked = rowCheckboxes.filter(function (cb) { return cb.checked; });
            deleteBtn.disabled = checked.length === 0;
            countLabel.textContent = checked.length > 0 ? checked.length + ' seleccionado(s)' : '';
            if (selectAll) {
                selectAll.checked = checked.length > 0 && checked.length === rowCheckboxes.length;
            }
        }

        rowCheckboxes.forEach(function (cb) { cb.addEventListener('change', updateState); });
        if (selectAll) {
            selectAll.addEventListener('change', function () {
                // Same checkbox drives Marcar, so flipping every row here has to fire each row's
                // own change handler too — that persists the mark and paints the row. Capture the
                // target state up front: updateState() (fired by each row's own change handler)
                // rewrites selectAll.checked mid-loop, so reading selectAll.checked fresh on every
                // iteration would stop after the first row once the running count no longer equals
                // the total.
                var targetChecked = selectAll.checked;
                rowCheckboxes.forEach(function (cb) {
                    if (cb.checked !== targetChecked) {
                        cb.checked = targetChecked;
                        cb.dispatchEvent(new Event('change'));
                    }
                });
                updateState();
            });
        }
    })();

    /* ── Master-Detail Drawer Controller ────────────────────────────────────────── */
    var activeDrawerCaseId = null;

    function openCaseDrawer(caseId) {
        activeDrawerCaseId = caseId;
        var form = document.getElementById('case-form-' + caseId);
        var row = form ? form.closest('tr') : null;
        if (!row) return;

        // Highlight active row in table
        document.querySelectorAll('.row-drawer-active').forEach(function (r) { r.classList.remove('row-drawer-active'); });
        row.classList.add('row-drawer-active');

        // Read form inputs from table row
        var nameInput = row.querySelector('input[name="nombre"]');
        var rutInput = row.querySelector('input[name="rut"]');
        var citacionInput = row.querySelector('input[name="citacion"]');
        var folioInput = row.querySelector('input[name="folioLicencia"]');
        var f8Input = row.querySelector('input[name="codigoF8"]');
        var ultimaInput = row.querySelector('input[name="ultimaCarpeta"]');
        var penultimaInput = row.querySelector('input[name="penultima"]');
        var estadoSelect = row.querySelector('select[name="estado"]');
        var decisionSelect = row.querySelector('select[name="decision"]');
        var idoneidadSelect = row.querySelector('select[name="idoneidad"]');
        var comunaInput = row.querySelector('input[name="comuna"]') || document.getElementById('comuna-' + caseId);
        var obsTextarea = row.querySelector('textarea[name="observaciones"]');

        // Populate drawer header
        document.getElementById('drawer-title-name').textContent = nameInput ? nameInput.value : ('Caso #' + caseId);
        document.getElementById('drawer-title-rut').textContent = rutInput ? rutInput.value : '—';
        document.getElementById('drawer-title-citation').textContent = citacionInput ? ('Citación: ' + citacionInput.value) : '';

        var slaBadge = row.querySelector('.badge-sla');
        var drawerSla = document.getElementById('drawer-title-sla');
        if (drawerSla) {
            drawerSla.innerHTML = slaBadge ? slaBadge.outerHTML : '';
        }

        // Populate drawer fields
        if (document.getElementById('drawer-estado') && estadoSelect) document.getElementById('drawer-estado').value = estadoSelect.value;
        if (document.getElementById('drawer-decision') && decisionSelect) document.getElementById('drawer-decision').value = decisionSelect.value;
        if (document.getElementById('drawer-idoneidad') && idoneidadSelect) document.getElementById('drawer-idoneidad').value = idoneidadSelect.value;
        if (document.getElementById('drawer-comuna')) document.getElementById('drawer-comuna').value = comunaInput ? comunaInput.value : '';
        if (document.getElementById('drawer-folio')) document.getElementById('drawer-folio').value = folioInput ? folioInput.value : '';
        if (document.getElementById('drawer-f8')) document.getElementById('drawer-f8').value = f8Input ? f8Input.value : '';
        if (document.getElementById('drawer-ultima')) document.getElementById('drawer-ultima').value = ultimaInput ? ultimaInput.value : '';
        if (document.getElementById('drawer-penultima')) document.getElementById('drawer-penultima').value = penultimaInput ? penultimaInput.value : '';
        if (document.getElementById('drawer-observaciones')) document.getElementById('drawer-observaciones').value = obsTextarea ? obsTextarea.value : '';

        // Populate licence chips
        var rowLicenceCheckboxes = row.querySelectorAll('input[name="licencias"]');
        var activeLicences = new Set();
        rowLicenceCheckboxes.forEach(function (cb) { if (cb.checked) activeLicences.add(cb.value); });

        document.querySelectorAll('.drawer-licence-chip').forEach(function (chip) {
            var input = chip.querySelector('input');
            if (input) {
                input.checked = activeLicences.has(input.value);
                if (input.checked) chip.classList.add('selected');
                else chip.classList.remove('selected');
            }
        });

        // Load live audit history into drawer
        loadDrawerAuditLog(caseId);

        // Open Drawer
        document.getElementById('case-drawer').classList.add('open');
        document.getElementById('drawer-backdrop').classList.add('open');
    }

    function closeCaseDrawer() {
        activeDrawerCaseId = null;
        var drawer = document.getElementById('case-drawer');
        var backdrop = document.getElementById('drawer-backdrop');
        if (drawer) drawer.classList.remove('open');
        if (backdrop) backdrop.classList.remove('open');
        document.querySelectorAll('.row-drawer-active').forEach(function (r) { r.classList.remove('row-drawer-active'); });
    }

    function syncDrawerToRow(fieldName, value) {
        if (!activeDrawerCaseId) return;
        var form = document.getElementById('case-form-' + activeDrawerCaseId);
        if (!form) return;
        var row = form.closest('tr');
        if (!row) return;

        var input = row.querySelector('[name="' + fieldName + '"]');
        if (input) {
            input.value = value;
            input.dispatchEvent(new Event('change', { bubbles: true }));
        }

        if (fieldName === 'observaciones') {
            var btn = row.querySelector('.btn-obs-trigger');
            if (btn) {
                btn.textContent = (value && value.trim().length > 0) ? '🗒️' : '📝';
                if (value && value.trim().length > 0) btn.classList.add('has-obs');
                else btn.classList.remove('has-obs');
            }
        }
    }

    function toggleDrawerLicence(licenceValue, isChecked) {
        if (!activeDrawerCaseId) return;
        var form = document.getElementById('case-form-' + activeDrawerCaseId);
        if (!form) return;
        var row = form.closest('tr');
        if (!row) return;

        var chip = document.getElementById('drawer-chip-' + licenceValue);
        if (chip) {
            if (isChecked) chip.classList.add('selected');
            else chip.classList.remove('selected');
        }

        var rowCheckboxes = row.querySelectorAll('input[name="licencias"]');
        rowCheckboxes.forEach(function (cb) {
            if (cb.value === licenceValue) {
                cb.checked = isChecked;
                cb.dispatchEvent(new Event('change', { bubbles: true }));
            }
        });
    }

    function loadDrawerAuditLog(caseId) {
        var container = document.getElementById('drawer-audit-content');
        if (!container) return;
        container.innerHTML = '<p style="color:var(--color-text-muted); font-size:var(--font-xs); margin:0;">Cargando historial...</p>';

        fetch('?handler=AuditLog&id=' + caseId, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function (res) { return res.json(); })
        .then(function (logs) {
            if (!logs || logs.length === 0) {
                container.innerHTML = '<p style="color:var(--color-text-muted); font-size:var(--font-xs); font-style:italic; margin:0;">Sin modificaciones registradas.</p>';
                return;
            }
            var html = '<div style="display:flex; flex-direction:column; gap:8px; max-height:220px; overflow-y:auto;">';
            logs.forEach(function (l) {
                html += '<div style="background:#ffffff; border:1px solid var(--color-border); border-radius:6px; padding:8px; font-size:var(--font-xs);">';
                html += '<div style="display:flex; justify-content:space-between; color:var(--color-text-muted); margin-bottom:4px;">';
                html += '<span><strong>' + (l.changedBy || 'Sistema') + '</strong></span><span>' + l.changedAt + '</span></div>';
                html += '<div>Modificó <strong>' + l.fieldName + '</strong>: ';
                html += '<span style="color:#dc2626; text-decoration:line-through;">' + (l.oldValue || '—') + '</span> &rarr; ';
                html += '<span style="color:#15803d; font-weight:600;">' + (l.newValue || '—') + '</span></div></div>';
            });
            html += '</div>';
            container.innerHTML = html;
        })
        .catch(function () {
            container.innerHTML = '<p style="color:#dc2626; font-size:var(--font-xs); margin:0;">Error al cargar historial.</p>';
        });
    }

    function openAuditModal(caseId, caseName) {
        var modal = document.getElementById('audit-modal');
        var title = document.getElementById('audit-modal-title');
        var content = document.getElementById('audit-modal-content');
        if (!modal || !title || !content) return;

        title.textContent = 'Historial: ' + (caseName || 'Caso #' + caseId);
        content.innerHTML = '<p style="color:var(--color-text-muted);">Cargando historial...</p>';
        modal.showModal();

        fetch('?handler=AuditLog&id=' + caseId, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(res) { return res.json(); })
        .then(function(logs) {
            if (!logs || logs.length === 0) {
                content.innerHTML = '<p style="color:var(--color-text-muted); font-style:italic; padding:10px 0;">No hay registros de cambios para este caso.</p>';
                return;
            }
            var html = '<table style="width:100%; border-collapse:collapse; font-size:var(--font-sm); text-align:left;">';
            html += '<thead><tr style="border-bottom:2px solid var(--color-border); color:var(--color-text-muted);"><th style="padding:6px;">Fecha</th><th style="padding:6px;">Usuario</th><th style="padding:6px;">Campo</th><th style="padding:6px;">Valor Anterior</th><th style="padding:6px;">Valor Nuevo</th></tr></thead><tbody>';
            logs.forEach(function(l) {
                html += '<tr style="border-bottom:1px solid #eee;">';
                html += '<td style="padding:6px; white-space:nowrap; color:var(--color-text-muted);">' + l.changedAt + '</td>';
                html += '<td style="padding:6px; font-weight:600;">' + (l.changedBy || '—') + '</td>';
                html += '<td style="padding:6px; font-weight:500;">' + l.fieldName + '</td>';
                html += '<td style="padding:6px; color:#b91c1c; text-decoration:line-through;">' + (l.oldValue || '—') + '</td>';
                html += '<td style="padding:6px; color:#15803d; font-weight:600;">' + (l.newValue || '—') + '</td>';
                html += '</tr>';
            });
            html += '</tbody></table>';
            content.innerHTML = html;
        })
        .catch(function(err) {
            content.innerHTML = '<p style="color:#b91c1c; padding:10px 0;">Error al cargar el historial de cambios.</p>';
        });
    }
</script>
}
