@page
@model LicenciasCarpetas.Dashboard.Pages.IndexModel
@{
    ViewData["Title"] = "Casos";
    // Esta pantalla fija su tabla al alto de la ventana para tener siempre a la vista la barra
    // de desplazamiento lateral; ninguna otra lo hace.
    ViewData["BodyClass"] = "viewport-locked";
    // El botón "Solicitar" manda un correo real a otra comuna — mismo permiso de módulo que el
    // resto de Cambio de Domicilio, aunque esta pantalla en sí quede abierta a todos los roles.
    var puedeCambioDomicilio = User.HasClaim("mod:cambio-domicilio", "true");
}

@if (Model.Message is not null)
{
    <p id="page-message-banner" class="message-banner @(Model.MessageIsError ? "message-error" : "")">@Model.Message</p>
}

<div class="card" style="padding:4px 10px; margin-bottom:6px;">
    <form method="get" class="filters-bar" style="display:flex; gap:3px 8px; align-items:flex-end; flex-wrap:wrap;">
        @* Sin estos tres, filtrar por Oficina/Año/etc. resetea lo que el operador eligió en
           "Ver" (tamaño de página) y en el orden de columna — el <select> de "Ver" ya guarda
           lo suyo por su cuenta, pero este otro <form> no sabía nada de ellos. *@
        <input type="hidden" name="size" value="@Model.PageSize" />
        <input type="hidden" name="sort" value="@Model.Sort" />
        <input type="hidden" name="desc" value="@Model.Descending" />
        <div>
            <label class="form-label" for="office">Oficina</label>
            <select name="office" id="office" onchange="this.form.submit()">
                <option value="">Todas</option>
                @foreach (var office in Enum.GetValues<Office>())
                {
                    <option value="@office" selected="@(Model.Office == office)">@OfficeCatalog.Display(office)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="year">Año</label>
            <select name="year" id="year" onchange="this.form.submit()">
                <option value="">Todos</option>
                @foreach (var year in Model.Years)
                {
                    <option value="@year" selected="@(Model.Year == year)">@year</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="month">Mes</label>
            <select name="month" id="month" onchange="this.form.submit()">
                <option value="">Todos</option>
                @for (var month = 1; month <= 12; month++)
                {
                    <option value="@month" selected="@(Model.Month == month)">@SpanishDate.MonthName(month)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="estado">Estado de la carpeta</label>
            <select name="estado" id="estado" onchange="this.form.submit()">
                <option value="">Todos</option>
                @foreach (var state in FolderStateCatalog.All)
                {
                    <option value="@state" selected="@(Model.Estado == state)">@FolderStateCatalog.Display(state)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="decision">Decisión final</label>
            <select name="decision" id="decision" onchange="this.form.submit()">
                <option value="">Todas</option>
                @foreach (var decision in FinalDecisionCatalog.All)
                {
                    <option value="@decision" selected="@(Model.Decision == decision)">@FinalDecisionCatalog.Display(decision)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="sector">Sector</label>
            <select name="sector" id="sector" onchange="this.form.submit()">
                <option value="">Todos</option>
                <option value="Archivo" selected="@(Model.Sector == FolderSector.Archivo)">Archivo</option>
                <option value="Oficina43" selected="@(Model.Sector == FolderSector.Oficina43)">Oficina 43</option>
            </select>
        </div>
        <div>
            <label class="form-label" for="search">Buscar</label>
            <input type="text" name="search" id="search" value="@Model.Search" placeholder="RUT o nombre..." />
        </div>
        @if (User.IsInRole("Administrador") || User.IsInRole("Jefatura") || User.IsInRole("Coordinador"))
        {
            @* Reportes imprimibles, alineados a la derecha de la fila de selects — estilo institucional *@
            <div style="margin-left:auto; display:flex; flex-direction:column; gap:4px; align-items:center; text-align:center;">
                <span style="font-weight:700; font-size:var(--font-xs); color:var(--color-primary); text-transform:uppercase; letter-spacing:0.6px; text-align:center; display:block; width:100%;">Informes de Sector</span>
                <div style="display:flex; gap:8px; align-items:center; justify-content:center;">
                    <a asp-page="/Sector" asp-route-sector="Archivo" class="nav-pill nav-doc text-sm">📄 Informe Archivo</a>
                    <a asp-page="/Sector" asp-route-sector="Oficina43" class="nav-pill nav-doc text-sm">📄 Informe Oficina 43</a>
                </div>
            </div>
        }
        @* Checkboxes + Filtrar + Limpiar en su propia fila, separados de los selects — así no se
           cortan entre sí al envolver cuando la ventana es angosta (6 selects + buscador ya llenan
           la fila de arriba por su cuenta). *@
        <div style="flex-basis:100%; display:flex; gap:3px 8px; align-items:center; flex-wrap:wrap;">
            <label class="text-md" style="display:flex; gap:6px; align-items:center;">
                <input type="checkbox" name="needsReview" value="true" checked="@Model.NeedsReview" onchange="this.form.submit()" />
                Requiere revisión (@Model.NeedsReviewCount)
            </label>
            <label class="text-md" style="display:flex; gap:6px; align-items:center;">
                <input type="checkbox" name="otherComuna" value="true" checked="@Model.OtherComuna" onchange="this.form.submit()" />
                Carpeta en otra comuna
            </label>
            <label class="text-md" style="display:flex; gap:6px; align-items:center; color:#b91c1c; font-weight:600;">
                <input type="checkbox" name="overdue" value="true" checked="@Model.Overdue" onchange="this.form.submit()" />
                ⚠️ Atrasados (+15 días)
            </label>
            <button type="submit" class="btn-primary text-base" style="padding:3px 12px;">Filtrar</button>
            <a asp-page="/Index" class="nav-pill text-sm">Limpiar</a>
        </div>
    </form>
</div>

<details class="card" style="padding:4px 10px; margin-bottom:6px;">
    <summary class="text-sm" style="cursor:pointer; font-weight:600;">Agregar caso a la agenda</summary>
    <form method="post" asp-page-handler="Add" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap; margin-top:8px;">
        <input type="hidden" name="size" value="@Model.PageSize" />
        <input type="hidden" name="sort" value="@Model.Sort" />
        <input type="hidden" name="desc" value="@Model.Descending" />
        <div>
            <label class="form-label">Nombre completo</label>
            <input type="text" name="nombre" required placeholder="ej: Gustavo Peña Castro" style="min-width:220px;" />
        </div>
        <div>
            <label class="form-label">RUT</label>
            <input type="text" name="rut" placeholder="ej: 18.785.387-7" />
        </div>
        <div>
            <label class="form-label">Fecha citación</label>
            <input type="text" name="citacion" placeholder="dd/mes/aaaa" />
        </div>
        <div>
            <label class="form-label">Oficina</label>
            <select name="office">
                @foreach (var office in Enum.GetValues<Office>())
                {
                    <option value="@office">@OfficeCatalog.Display(office)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Última carpeta (fecha o comuna)</label>
            <input type="text" name="ultimaCarpeta" placeholder="dd/mes/aaaa o VIÑA DEL MAR" />
        </div>
        <div>
            <label class="form-label">Penúltima carpeta</label>
            <input type="text" name="penultima" placeholder="dd/mes/aaaa" />
        </div>
        <div>
            <label class="form-label">Código F8</label>
            <input type="text" name="codigoF8" placeholder="ej: F8-2026-114" />
        </div>
        <div>
            <label class="form-label">Estado de la carpeta</label>
            <select name="estado">
                <option value="">—</option>
                @foreach (var state in FolderStateCatalog.Selectable)
                {
                    <option value="@state">@FolderStateCatalog.Display(state)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Decisión final</label>
            <select name="decision">
                <option value="">—</option>
                @foreach (var decision in FinalDecisionCatalog.All)
                {
                    <option value="@decision">@FinalDecisionCatalog.Display(decision)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Idoneidad moral</label>
            <select name="idoneidad">
                <option value="">—</option>
                @foreach (var idoneity in MoralIdoneityCatalog.All)
                {
                    <option value="@idoneity">@MoralIdoneityCatalog.Display(idoneity)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Atención</label>
            <input type="text" name="atencion" placeholder="ej: SI, EN AV. ARGENTINA" />
        </div>
        <button type="submit" class="btn-primary btn-sm" style="padding:6px 14px;">Agregar</button>
    </form>
</details>

@* Paginación arriba de la tabla, no debajo: la tabla llega hasta el borde inferior de la ventana
   y su barra de desplazamiento lateral queda ahí, siempre a la vista. Con los botones abajo, la
   barra subía y se comía la última fila. *@
<div class="text-sm" style="display:flex; gap:10px; align-items:center; margin:0 0 4px 2px; flex-wrap:wrap;">
    <span>@Model.TotalCount caso(s) — página @Model.PageNumber de @Model.TotalPages</span>

    @* Cuántas filas por página. Va como formulario GET con los filtros actuales en campos ocultos,
       para que cambiar la cantidad no pierda lo que el operador tenía filtrado ni el orden. *@
    <form method="get" style="display:flex; gap:6px; align-items:center;">
        @foreach (var (key, value) in Model.RouteValues(1))
        {
            @if (key != "size")
            {
                <input type="hidden" name="@key" value="@value" />
            }
        }
        <label for="size">Ver</label>
        <select name="size" id="size" onchange="this.form.submit()">
            @foreach (var size in LicenciasCarpetas.Dashboard.Pages.IndexModel.PageSizes)
            {
                <option value="@size" selected="@(Model.PageSize == size)">@size</option>
            }
        </select>
        <span>por página</span>
    </form>
    @if (Model.TotalPages > 1)
    {
        @if (Model.PageNumber > 1)
        {
            <a class="nav-pill text-xs" asp-page="/Index" asp-all-route-data="@Model.RouteValues(Model.PageNumber - 1)">← Anterior</a>
        }
        @if (Model.PageNumber < Model.TotalPages)
        {
            <a class="nav-pill text-xs" asp-page="/Index" asp-all-route-data="@Model.RouteValues(Model.PageNumber + 1)">Siguiente →</a>
        }
    }

    <a asp-page="/Index" asp-page-handler="Export"
       asp-route-office="@Model.Office" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
       asp-route-estado="@Model.Estado" asp-route-decision="@Model.Decision" asp-route-sector="@Model.Sector"
       asp-route-needsReview="@Model.NeedsReview" asp-route-otherComuna="@Model.OtherComuna"
       asp-route-search="@Model.Search" class="nav-pill text-xs" style="margin-left:auto;">Exportar a Excel</a>
</div>

@* Sugerencias de la columna ATENCIÓN tal como se escriben en el libro; el campo sigue siendo texto
   libre, la lista solo evita tipearlas completas. *@
<datalist id="atencion-opciones">
    @foreach (var office in Enum.GetValues<Office>())
    {
        <option value="SI, EN @OfficeCatalog.Display(office).ToUpperInvariant()"></option>
    }
</datalist>

@* Un solo checkbox por fila: marca para impresión por sector Y selecciona para borrado masivo
   a la vez (decisión del usuario pese al riesgo de que un click de más en "Eliminar
   seleccionados" borre filas que solo se querían marcar — el borrado es soft-delete,
   recuperable desde Papelera). Vive dentro de <tr>, asociado a este <form> vacío por el
   atributo form= — así no hace falta envolver la tabla entera en un <form> que chocaría con
   los <form> propios de cada fila. *@
<form id="bulk-delete-form" method="post" asp-page-handler="DeleteSeleccionados">
    <input type="hidden" name="size" value="@Model.PageSize" />
    <input type="hidden" name="sort" value="@Model.Sort" />
    <input type="hidden" name="desc" value="@Model.Descending" />
</form>
<div style="display:flex; justify-content:flex-end; align-items:center; gap:8px; margin-bottom:4px;">
    <span id="bulk-delete-count" class="text-xs" style="color:var(--color-text-muted);"></span>
    <button type="submit" form="bulk-delete-form" class="btn-danger btn-sm" id="bulk-delete-btn" disabled
            style="padding:3px 10px; font-size:var(--font-xs);"
            onclick="return confirm('Los casos seleccionados se moverán a la Papelera. Se pueden restaurar desde ahí. ¿Confirmar?');">
        🗑️ Eliminar seleccionados
    </button>
</div>

<div class="card table-card">
    <table class="cases cases-index">
        <thead>
            <tr>
                <th class="col-sticky-marcar">Marcar<br /><input type="checkbox" id="select-all-rows" title="Marcar/seleccionar todos" /></th>
                @* El texto va dentro de un <span>: escrito como "Oficina@Model...", Razor lee
                   "texto@algo" como una dirección de correo y lo imprime literal en vez de
                   evaluarlo. El ">" que cierra el span rompe esa heurística. *@
                <th class="col-sticky-citacion"><a asp-page="/Index" asp-all-route-data="@Model.SortRouteValues(CaseSort.CitationDate)" class="sort-link"><span>Citación</span>@Model.SortIndicator(CaseSort.CitationDate)</a></th>
                <th class="name-cell col-sticky-nombre"><a asp-page="/Index" asp-all-route-data="@Model.SortRouteValues(CaseSort.Name)" class="sort-link"><span>Nombre completo</span>@Model.SortIndicator(CaseSort.Name)</a></th>
                <th class="rut-cell col-sticky-rut"><a asp-page="/Index" asp-all-route-data="@Model.SortRouteValues(CaseSort.Rut)" class="sort-link"><span>RUT</span>@Model.SortIndicator(CaseSort.Rut)</a></th>
                <th><a asp-page="/Index" asp-all-route-data="@Model.SortRouteValues(CaseSort.Office)" class="sort-link"><span>Oficina</span>@Model.SortIndicator(CaseSort.Office)</a></th>
                <th><a asp-page="/Index" asp-all-route-data="@Model.SortRouteValues(CaseSort.FolderUploadedDate)" class="sort-link"><span>Fecha subida de carpeta</span>@Model.SortIndicator(CaseSort.FolderUploadedDate)</a></th>
                <th><a asp-page="/Index" asp-all-route-data="@Model.SortRouteValues(CaseSort.LastFolderDate)" class="sort-link"><span>Fecha última carpeta</span>@Model.SortIndicator(CaseSort.LastFolderDate)</a></th>
                @* Sector va junto a Última carpeta: es la fecha de la que se calcula. *@
                <th>Sector</th>
                <th title="Código del caso F8. Texto libre">Código F8</th>
                <th title="Fecha de la carpeta anterior a la última. No influye en el sector">Fecha penúltima<br />carpeta</th>
                <th title="Clases que el contribuyente viene a obtener. Se pueden marcar varias">Tipo de licencia</th>
                <th><a asp-page="/Index" asp-all-route-data="@Model.SortRouteValues(CaseSort.FolderState)" class="sort-link"><span>Estado carpeta</span>@Model.SortIndicator(CaseSort.FolderState)</a></th>
                <th>Comuna</th>
                <th>Idoneidad</th>
                <th><a asp-page="/Index" asp-all-route-data="@Model.SortRouteValues(CaseSort.FinalDecision)" class="sort-link"><span>Decisión final</span>@Model.SortIndicator(CaseSort.FinalDecision)</a></th>
                <th title="Número de folio de la licencia. Texto libre">Folio de licencia</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
        @{ var rowIndex = 0; }
        @foreach (var item in Model.Cases)
        {
            var rowClass = rowIndex % 2 == 1 ? "row-alt" : "";
            var reviewClass = item.NeedsReview ? "row-needs-review" : "";
            @* El color de la fila viene del estado de la carpeta, igual que en el Excel. *@
            var estadoClass = FolderStateCatalog.CssClass(item.FolderState);
            var duplicadoClass = Model.DuplicateRuts.Contains(item.Rut ?? string.Empty) ? "rut-duplicado" : "";
            var markedClass = item.Marked ? "row-selected" : "";
            @* Idoneidad moral en alerta o por revisar: la fila entera avisa, no solo la celda —
               es lo primero que se necesita ver al mirar la agenda del día. *@
            var idoneidadClass = item.MoralIdoneity switch
            {
                MoralIdoneity.Alertada => "row-alertada",
                MoralIdoneity.Revisar => "row-revisar",
                _ => ""
            };
            rowIndex++;

            @* Cada campo se dimensiona según lo que contiene, así ningún nombre ni comuna queda
               cortado; la tabla crece hacia la derecha y la tarjeta se desplaza en horizontal. *@
            var lastFolderText = item.LastFolderDate is { } lastDate
                ? LicenciasCarpetas.Dashboard.Pages.IndexModel.FormatDate(lastDate)
                : item.LastFolderComuna ?? string.Empty;
            var nameSize = Math.Max(26, (item.FullName?.Length ?? 0) + 2);
            var lastFolderSize = Math.Max(12, lastFolderText.Length + 2);
            var attentionSize = Math.Max(16, (item.AttentionNote?.Length ?? 0) + 2);
            <tr class="@rowClass @estadoClass @duplicadoClass @reviewClass @idoneidadClass @markedClass" ondblclick="openCaseDrawer(@item.Id)">
                <td class="marked-cell col-sticky-marcar">
                    <form method="post" asp-page-handler="ToggleMarked" class="marked-form" id="marked-form-@item.Id">
                        <input type="hidden" name="id" value="@item.Id" />
                    </form>
                    <input type="checkbox" class="bulk-select-checkbox" form="bulk-delete-form" name="selectedIds" value="@item.Id"
                           @(item.Marked ? "checked" : "")
                           onchange="toggleRowMark(this, document.getElementById('marked-form-@item.Id'))"
                           title="Marcar caso (impresión de sector y borrado masivo)" />
                </td>
                <td class="col-sticky-citacion">
                    <form method="post" asp-page-handler="Save" id="case-form-@item.Id"
                          asp-route-office="@Model.Office" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                          asp-route-estado="@Model.Estado" asp-route-decision="@Model.Decision" asp-route-sector="@Model.Sector"
                          asp-route-needsReview="@Model.NeedsReview" asp-route-otherComuna="@Model.OtherComuna"
                          asp-route-search="@Model.Search" asp-route-p="@Model.PageNumber"
                          asp-route-size="@Model.PageSize" asp-route-sort="@Model.Sort" asp-route-desc="@Model.Descending">
                        <input type="hidden" name="id" value="@item.Id" />
                    </form>
                    <div style="display:flex; align-items:center; gap:4px;">
                        <input type="text" name="citacion" form="case-form-@item.Id" class="input-inline" size="13"
                               value="@LicenciasCarpetas.Dashboard.Pages.IndexModel.FormatDate(item.CitationDate)" placeholder="dd/mes/aaaa" />
                        @if (item.AgingAlert == CaseAgingAlert.Overdue)
                        {
                            <span class="badge-sla badge-sla-overdue" title="Trámite pendiente con @item.DaysSinceCitation días transcurridos">🔴 +@item.DaysSinceCitation d</span>
                        }
                        else if (item.AgingAlert == CaseAgingAlert.Warning)
                        {
                            <span class="badge-sla badge-sla-warning" title="Trámite pendiente con @item.DaysSinceCitation días transcurridos">🟡 @item.DaysSinceCitation d</span>
                        }
                    </div>
                </td>
                <td class="name-cell col-sticky-nombre">
                    @if (item.NeedsReview)
                    {
                        <span class="review-alert" title="Requiere revisión — datos incompletos en la fila original">⚠</span>
                    }
                    @if (item.MoralIdoneity == MoralIdoneity.Alertada)
                    {
                        <span class="idoneidad-icon" title="Idoneidad moral: ALERTADA">🚨</span>
                    }
                    else if (item.MoralIdoneity == MoralIdoneity.Revisar)
                    {
                        <span class="idoneidad-icon" title="Idoneidad moral: REVISAR">⚠️</span>
                    }
                    else if (item.MoralIdoneity == MoralIdoneity.Aceptada)
                    {
                        <span class="idoneidad-icon" title="Idoneidad moral: ACEPTADA">✅</span>
                    }
                    <input type="text" name="nombre" form="case-form-@item.Id" class="input-inline name-input"
                           size="@nameSize" value="@item.FullName" placeholder="Nombre completo" />
                </td>
                <td class="text-cell rut-cell col-sticky-rut">
                    <span class="rut-con-obs">
                        <input type="text" name="rut" form="case-form-@item.Id" class="input-inline rut-input" size="14" value="@item.Rut" />
                        <button type="button" class="btn-obs-trigger @(string.IsNullOrWhiteSpace(item.Observations) ? "" : "has-obs")"
                                title="Observaciones"
                                onclick="toggleObsPopover(this, @item.Id)">
                            @(string.IsNullOrWhiteSpace(item.Observations) ? "📝" : "🗒️")
                        </button>
                        <textarea name="observaciones" form="case-form-@item.Id" style="display:none;">@item.Observations</textarea>
                    </span>
                </td>
                <td class="text-cell">@OfficeCatalog.Display(item.Office)</td>
                <td>
                    @* Solo la escribe el sistema al marcar un estado de "ya subida" (fillUploadDateIfMissing) —
                       readonly, no disabled, para que el valor siga viajando al guardar. *@
                    <input type="text" name="subida" form="case-form-@item.Id" class="input-inline" size="15"
                           value="@LicenciasCarpetas.Dashboard.Pages.IndexModel.FormatDate(item.FolderUploadedDate)"
                           readonly title="Se completa sola al marcar un estado de subida" />
                </td>
                <td>
                    <input type="text" name="ultimaCarpeta" form="case-form-@item.Id" class="input-inline"
                           size="@lastFolderSize" value="@lastFolderText" placeholder="dd/mes/aaaa"
                           title="Fecha de la última carpeta, o la comuna donde está la carpeta" />
                </td>
                <td class="text-cell sector-cell">@FolderSectorCatalog.Display(item.Sector)</td>
                <td>
                    <input type="text" name="codigoF8" form="case-form-@item.Id" class="input-inline"
                           size="@Math.Max(12, (item.CodigoF8?.Length ?? 0) + 2)" value="@item.CodigoF8"
                           />
                </td>
                <td>
                    <input type="text" name="penultima" form="case-form-@item.Id" class="input-inline" size="15"
                           value="@LicenciasCarpetas.Dashboard.Pages.IndexModel.FormatDate(item.PenultimateFolderDate)"
                           placeholder="dd/mes/aaaa" />
                </td>
                <td>
                    @* Selección múltiple de clases de licencia con popover flotante *@
                    <button type="button" class="btn-licencias-trigger" id="lic-btn-@item.Id"
                            onclick="openLicenciasPopover(this, @item.Id)"
                            data-licencias="@(item.LicenceClasses ?? "")">
                        <span class="lic-btn-text">@(string.IsNullOrWhiteSpace(LicenceClassCatalog.DisplayList(item.LicenceClasses)) ? "—" : LicenceClassCatalog.DisplayList(item.LicenceClasses))</span>
                        <span class="lic-btn-arrow">▾</span>
                    </button>
                    <input type="hidden" name="licenciasSerializadas" id="lic-hidden-@item.Id" form="case-form-@item.Id" value="@(item.LicenceClasses ?? "")" />
                </td>
                @* La columna ATENCIÓN se sacó de la tabla por pedido del operador, pero el valor
                   viaja igual en el formulario: sin él, guardar una fila borraría la atención y la
                   persona dejaría de contar como atendida en Estadísticas. *@
                <input type="hidden" name="atencion" form="case-form-@item.Id" value="@item.AttentionNote" />
                <td>
                    <select name="estado" id="estado-@item.Id" form="case-form-@item.Id" class="input-inline estado-select"
                            onchange="repaintRow(this)">
                        <option value="">@(item.FolderStateRaw ?? "—")</option>
                        @foreach (var state in FolderStateCatalog.Selectable)
                        {
                            <option value="@state" selected="@(item.FolderState == state)">@FolderStateCatalog.Display(state)</option>
                        }
                        @* Un caso que ya tiene un estado retirado conserva su opción: sin ella el
                           desplegable mostraría "—" y guardar la fila le borraría el estado. *@
                        @if (item.FolderState is { } current && FolderStateCatalog.IsRetired(current))
                        {
                            <option value="@current" selected="selected">@FolderStateCatalog.Display(current)</option>
                        }
                    </select>
                </td>
                <td>
                    <input type="text" name="comuna" id="comuna-@item.Id" form="case-form-@item.Id" class="input-inline" style="width:110px; text-transform:uppercase;"
                           value="@item.CambioDomicilioComuna" placeholder="ej: VALPARAÍSO" oninput="this.value = this.value.toUpperCase();" />
                </td>
                <td>
                    <select name="idoneidad" form="case-form-@item.Id" class="input-inline" onchange="repaintIdoneidad(this)">
                        <option value="">—</option>
                        @foreach (var idoneity in MoralIdoneityCatalog.All)
                        {
                            <option value="@idoneity" selected="@(item.MoralIdoneity == idoneity)">@MoralIdoneityCatalog.Display(idoneity)</option>
                        }
                    </select>
                </td>
                <td>
                    <select name="decision" form="case-form-@item.Id" class="input-inline" onchange="onDecisionChanged(this)">
                        <option value="">@(item.FinalDecisionRaw ?? "—")</option>
                        @foreach (var decision in FinalDecisionCatalog.All)
                        {
                            <option value="@decision" selected="@(item.FinalDecision == decision)">@FinalDecisionCatalog.Display(decision)</option>
                        }
                    </select>
                </td>
                <td>
                    <input type="text" name="folioLicencia" form="case-form-@item.Id" class="input-inline"
                           size="@Math.Max(10, (item.FolioLicencia?.Length ?? 0) + 2)" value="@item.FolioLicencia"
                           placeholder="Folio" />
                </td>
                <td style="display:flex; gap:6px; align-items:center; justify-content:center;">
                    <button type="button" class="btn-drawer-open" onclick="openCaseDrawer(@item.Id)" title="Abrir panel lateral de detalle">👁️</button>
                    <button type="button" class="btn-audit-log" onclick="openAuditModal(@item.Id, '@(item.FullName?.Replace("'", "\\'"))')" title="Ver historial de cambios de este caso">📜</button>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id"
                          asp-route-office="@Model.Office" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                          asp-route-estado="@Model.Estado" asp-route-decision="@Model.Decision" asp-route-sector="@Model.Sector"
                          asp-route-needsReview="@Model.NeedsReview" asp-route-otherComuna="@Model.OtherComuna"
                          asp-route-search="@Model.Search" asp-route-p="@Model.PageNumber"
                          asp-route-size="@Model.PageSize" asp-route-sort="@Model.Sort" asp-route-desc="@Model.Descending"
                          onsubmit="return confirm('¿Enviar este caso a la papelera?');" style="display:inline;">
                        <button type="submit" class="btn-danger" style="padding:4px 8px; border-radius:4px; font-size:var(--font-xs); font-weight:700; cursor:pointer;" title="Eliminar caso">🗑️</button>
                    </form>
                    @if (puedeCambioDomicilio)
                    {
                        <form method="post" asp-page-handler="SolicitarCambioDomicilio" class="solicitar-form"
                              style="display:@(item.FolderState == FolderState.CambioDomicilioSolicitado ? "inline" : "none");"
                              data-solicitar-comuna-id="comuna-@item.Id" data-solicitar-estado-id="estado-@item.Id"
                              data-solicitar-fullname="@item.FullName"
                              onsubmit="return prepararSolicitar(this);">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="comuna" />
                            <input type="hidden" name="estado" />
                            <button type="submit" class="btn-primary" title="Crear la solicitud y enviar el correo a la comuna">Solicitar</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<!-- Master-Detail Side Drawer -->
