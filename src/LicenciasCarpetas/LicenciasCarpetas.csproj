<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-LicenciasCarpetas-6f1c07a1-58a1-4f2c-9f21-3d4b8b6c9a10</UserSecretsId>
    <!-- Same escudo municipal icon as outlook-comuna-router: embedded in the exe so the taskbar
         and the desktop shortcut show it without any extra IconLocation wiring. -->
    <ApplicationIcon>wwwroot\img\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LicenciasCarpetas.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Environment-specific config (real workbook paths, local overrides) is git-ignored and must
         never travel inside bin/, obj/ or a publish/ folder, since those get copied around whole. -->
    <Content Update="appsettings.Development.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />

    <!-- ContentRootPath is pinned to the exe's folder (see Program.cs), so the web root is the
         wwwroot *next to the exe*. The SDK only copies wwwroot on publish, which left the app
         running from bin/ with no stylesheet at all — copy it to the build output too. -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="seed\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
