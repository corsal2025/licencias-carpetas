.DS_Store

# .NET
bin/
obj/
*.user

# Libros Excel: traen nombres y RUT reales, nunca van a git (se leen, no se versionan)
*.xlsx
*.xls

# Environment-specific config
**/appsettings.Development.json
# Secretos y overrides de instalación: credenciales EWS del correo institucional
**/appsettings.Local.json
.env

# TLS certificate private key material
certs/

# Runtime data: the SQLite database holds real names and RUTs, exports do too.
# Anchored to the one real runtime folder (not **/data/*, which on Windows' case-insensitive
# git config also silently matched source folders like F8/Data/ and CambioDomicilio/Data/,
# excluding real repository code from every commit without a warning).
/src/LicenciasCarpetas/data/*
*.db

publish/

# Local Claude Code skill-registry cache and agent worktrees
.atl/
.claude/

# Logs
*.log

